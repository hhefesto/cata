def pre.HsCopy.p0() -> String:
  "# List functions at a function that uses its accumulator, or the element,\n# more than once (a lambda's +): HsList's foldr and foldl, whose answer may\n# be a function, and Base's List.any and List.all take it once (Fold.bend's\n# fd.cp.name writes these where the lambda copies and the answer is Data)\ndef HsList.foldrc(~A: Data, ~B: Data, ~f: A -> B -> B, xs: List<&2, A>, z: B) -> B:\n  match xs:\n    case Nil{}:\n      z\n    case +h <> t:\n      +r = HsList.foldrc(~A, ~B, ~f, t, z)\n      f(h)(r)\n\ndef HsList.foldlc(~A: Data, ~B: Data, ~f: B -> A -> B, xs: List<&2, A>, +acc: B) -> B:\n  match xs:\n    case Nil{}:\n      acc\n    case +h <> t:\n      HsList.foldlc(~A, ~B, ~f, t, f(acc)(h))\n\ndef HsList.anyc(~a: Quant, ~A: Data, ~p: A -> Bool, xs: List<&2, A>) -> Bool:\n  match xs:\n    case Nil{}:\n      False{}\n    case +h <> t:\n      HsBool.if(Bool, p(h), _ => True{}, _ => HsList.anyc(~a, ~A, ~p, t))\n\ndef HsList.allc(~a: Quant, ~A: Data, ~p: A -> Bool, xs: List<&2, A>) -> Bool:\n  match xs:\n    case Nil{}:\n      True{}\n    case +h <> t:\n      HsBool.if(Bool, p(h), _ => HsList.allc(~a, ~A, ~p, t), _ => False{})\n\n"

def pre.HsCopy() -> String:
  pre.HsCopy.p0()
def pre.HsListMore.p0() -> String:
  "# Data.List's splitAt, transpose, dropWhileEnd, uncons, scanl and elemIndex\n# (base's definitions; transpose's recursion is bounded by how many elements\n# and lists there are, which each step takes one of)\ndef HsList.splitAt.put(-A: Data, h: A, p: Sigma<&2, &2, List<&2, A>, _ => List<&2, A>>) -> Sigma<&2, &2, List<&2, A>, _ => List<&2, A>>:\n  match p:\n    case Tuple{a, b}:\n      Tuple{h <> a, b}\n\ndef HsList.splitAt(~A: Data, n: Nat, xs: List<&2, A>) -> Sigma<&2, &2, List<&2, A>, _ => List<&2, A>>:\n  match n xs:\n    case 0n ys:\n      Tuple{Nil{}, ys}\n    case 1n+p Nil{}:\n      Tuple{Nil{}, Nil{}}\n    case 1n+p h <> t:\n      HsList.splitAt.put(A, h, HsList.splitAt(~A, p, t))\n\ndef HsList.heads(-A: Data, xss: List<&2, List<&2, A>>) -> List<&2, A>:\n  match xss:\n    case Nil{}:\n      Nil{}\n    case Con{Nil{}, t}:\n      HsList.heads(A, t)\n    case Con{Con{h, _}, t}:\n      h <> HsList.heads(A, t)\n\ndef HsList.tails1(-A: Data, xss: List<&2, List<&2, A>>) -> List<&2, List<&2, A>>:\n  match xss:\n    case Nil{}:\n      Nil{}\n    case Con{Nil{}, t}:\n      HsList.tails1(A, t)\n    case Con{Con{_, r}, t}:\n      r <> HsList.tails1(A, t)\n\ndef HsList.size2(-A: Data, xss: List<&2, List<&2, A>>) -> Nat:\n  match xss:\n    case Nil{}:\n      0n\n    case h <> t:\n      1n+Nat.add(List.length(&2, A, h), HsList.size2(A, t))\n\ndef HsList.transpose.go(-A: Data, fuel: Nat, xss: List<&2, List<&2, A>>) -> List<&2, List<&2, A>>:\n  match fuel xss:\n    case 0n _:\n      Nil{}\n    case 1n+p Nil{}:\n      Nil{}\n    case 1n+p Con{Nil{}, t}:\n      HsList.transpose.go(A, p, t)\n    case 1n+p Con{Con{x, xs}, +t}:\n      (x <> HsList.heads(A, t)) <> HsList.transpose.go(A, p, xs <> HsList.tails1(A, t))\n\ndef HsList.transpose(~A: Data, +xss: List<&2, List<&2, A>>) -> List<&2, List<&2, A>>:\n  HsList.transpose.go(A, HsList.size2(A, xss), xss)\n\ndef HsList.dropWhileEnd.put(-A: Data, b: Bool, h: A, r: List<&2, A>) -> List<&2, A>:\n  match b r:\n    case True{} Nil{}:\n      Nil{}\n    case False{} Nil{}:\n      h <> Nil{}\n    case _ Con{x, t}:\n      h <> x <> t\n\ndef HsList.dropWhileEnd(~A: Data, ~p: A -> Bool, xs: List<&2, A>) -> List<&2, A>:\n  match xs:\n    case Nil{}:\n      Nil{}\n    case +h <> t:\n      HsList.dropWhileEnd.put(A, p(h), h, HsList.dropWhileEnd(~A, ~p, t))\n\ndef HsList.uncons(~A: Data, xs: List<&2, A>) -> Maybe<&2, Sigma<&2, &2, A, _ => List<&2, A>>>:\n  match xs:\n    case Nil{}:\n      None{}\n    case h <> t:\n      Some{Tuple{h, t}}\n\ndef HsList.scanl.go(~B: Data, ~A: Data, ~f: B -> A -> B, xs: List<&2, A>, +q: B) -> List<&2, B>:\n  match xs:\n    case Nil{}:\n      q <> Nil{}\n    case h <> t:\n      q <> HsList.scanl.go(~B, ~A, ~f, t, f(q)(h))\n\n"

def pre.HsListMore.p1() -> String:
  "def HsList.scanl(~B: Data, ~A: Data, ~f: B -> A -> B, q: B, xs: List<&2, A>) -> List<&2, B>:\n  HsList.scanl.go(~B, ~A, ~f, xs, q)\n\ndef HsList.elemIndex.go(~K: Data, ~eq: K -> K -> Bool, +x: K, xs: List<&2, K>, +n: Nat) -> Maybe<&2, Nat>:\n  match xs:\n    case Nil{}:\n      None{}\n    case h <> t:\n      HsBool.if(Maybe<&2, Nat>, eq(x)(h), _ => Some{n}, _ => HsList.elemIndex.go(~K, ~eq, x, t, 1n+n))\n\ndef HsList.elemIndex(~K: Data, ~eq: K -> K -> Bool, x: K, xs: List<&2, K>) -> Maybe<&2, Nat>:\n  HsList.elemIndex.go(~K, ~eq, x, xs, 0n)\n\n# lookup in a list whose values hold functions (no Data: each used once)\ndef HsList.lookup1(~K: Data, ~V: Type, ~eq: K -> K -> Bool, +k: K, xs: List<&1, Sigma<&2, &1, K, _ => V>>) -> Maybe<&1, V>:\n  match xs:\n    case Nil{}:\n      None{}\n    case Tuple{+k2, v} <> t:\n      HsBool.if(Maybe<&1, V>, eq(k)(k2), _ => Some{v}, _ => HsList.lookup1(~K, ~V, ~eq, k, t))\n\n# fst and snd of a pair whose second half holds a function\ndef HsList.fst1(~A: Data, ~B: Type, p: Sigma<&2, &1, A, _ => B>) -> A:\n  match p:\n    case Tuple{a, b}:\n      a\n\ndef HsList.snd1(~A: Data, ~B: Type, p: Sigma<&2, &1, A, _ => B>) -> B:\n  match p:\n    case Tuple{a, b}:\n      b\n"

def pre.HsListMore() -> String:
  pre.HsListMore.p0() ++ pre.HsListMore.p1()
def pre.HsMapMore.p0() -> String:
  "\n# Data.Map's and Data.Set's functions after the first ones (HsPrelude's\n# HsMap and HsSet: the pairs, the keys, in ascending order of the key, each\n# key once; compare at K the template ~cmp), Data.Map's semantics on that\n# list.\n\n# insertWithKey f k new: f k new old at a key there\ndef HsMap.insertWithKey(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~f: K -> V -> V -> V, +k: K, +v: V, m: HsMap<K, V>) -> HsMap<K, V>:\n  match m:\n    case HsMap.Tip{}:\n      HsMap.Bin{k, v, HsMap.Tip{}}\n    case HsMap.Bin{+k2, +v2, +t}:\n      HsCmp.on(HsMap<K, V>, cmp(k, k2), _ => HsMap.Bin{k, v, HsMap.Bin{k2, v2, t}}, _ => HsMap.Bin{k, f(k)(v)(v2), t}, _ => HsMap.Bin{k2, v2, HsMap.insertWithKey(~K, ~V, ~cmp, ~f, k, v, t)})\n\n# unionWithKey f a b: f k (a's) (b's) at a key in both\ndef HsMap.unionWithKey(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~f: K -> V -> V -> V, a: HsMap<K, V>, b: HsMap<K, V>) -> HsMap<K, V>:\n  match a:\n    case HsMap.Tip{}:\n      b\n    case HsMap.Bin{k, v, t}:\n      HsMap.insertWithKey(~K, ~V, ~cmp, ~f, k, v, HsMap.unionWithKey(~K, ~V, ~cmp, ~f, t, b))\n\ndef HsMap.unionsWith.go(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~f: V -> V -> V, ms: List<&2, HsMap<K, V>>, acc: HsMap<K, V>) -> HsMap<K, V>:\n  match ms:\n    case Nil{}:\n      acc\n    case m <> t:\n      HsMap.unionsWith.go(~K, ~V, ~cmp, ~f, t, HsMap.unionWith(~K, ~V, ~cmp, ~f, acc, m))\n\n# unionsWith f ms: the maps' unionWith f, the first's values first\ndef HsMap.unionsWith(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~f: V -> V -> V, ms: List<&2, HsMap<K, V>>) -> HsMap<K, V>:\n  match ms:\n    case Nil{}:\n      HsMap.Tip{}\n    case m <> t:\n      HsMap.unionsWith.go(~K, ~V, ~cmp, ~f, t, m)\n\ndef HsMap.intersectionWith.at(~K: Data, ~V: Data, ~W: Data, ~X: Data, ~f: V -> W -> X, k: K, v: V, w: Maybe<&2, W>, r: HsMap<K, X>) -> HsMap<K, X>:\n  match w:\n    case None{}:\n      r\n    case Some{x}:\n      HsMap.Bin{k, f(v)(x), r}\n\n# intersectionWith f a b: the keys in both, f at a's value and b's\ndef HsMap.intersectionWith(~K: Data, ~V: Data, ~W: Data, ~X: Data, ~cmp: K -> K -> Cmp, ~f: V -> W -> X, a: HsMap<K, V>, +b: HsMap<K, W>) -> HsMap<K, X>:\n  match a:\n    case HsMap.Tip{}:\n      HsMap.Tip{}\n    case HsMap.Bin{+k, v, t}:\n      HsMap.intersectionWith.at(~K, ~V, ~W, ~X, ~f, k, v, HsMap.lookup(~K, ~W, ~cmp, k, b), HsMap.intersectionWith(~K, ~V, ~W, ~X, ~cmp, ~f, t, b))\n\n# restrictKeys m s: m's pairs whose key s holds\ndef HsMap.restrictKeys(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, m: HsMap<K, V>, +s: HsSet<K>) -> HsMap<K, V>:\n  match m:\n    case HsMap.Tip{}:\n      HsMap.Tip{}\n    case HsMap.Bin{+k, +v, +t}:\n"

def pre.HsMapMore.p1() -> String:
  "      HsBool.if(HsMap<K, V>, HsSet.member(~K, ~cmp, k, s), _ => HsMap.Bin{k, v, HsMap.restrictKeys(~K, ~V, ~cmp, t, s)}, _ => HsMap.restrictKeys(~K, ~V, ~cmp, t, s))\n\n# withoutKeys m s: m's pairs whose key s does not hold\ndef HsMap.withoutKeys(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, m: HsMap<K, V>, +s: HsSet<K>) -> HsMap<K, V>:\n  match m:\n    case HsMap.Tip{}:\n      HsMap.Tip{}\n    case HsMap.Bin{+k, +v, +t}:\n      HsBool.if(HsMap<K, V>, HsSet.member(~K, ~cmp, k, s), _ => HsMap.withoutKeys(~K, ~V, ~cmp, t, s), _ => HsMap.Bin{k, v, HsMap.withoutKeys(~K, ~V, ~cmp, t, s)})\n\n# fromSet f s: each key of s with f at it (the keys already in order)\ndef HsMap.fromSet(~K: Data, ~V: Data, ~f: K -> V, s: HsSet<K>) -> HsMap<K, V>:\n  match s:\n    case HsSet.Tip{}:\n      HsMap.Tip{}\n    case HsSet.Bin{+k, t}:\n      HsMap.Bin{k, f(k), HsMap.fromSet(~K, ~V, ~f, t)}\n\ndef HsMap.split.below(~K: Data, ~V: Data, k: K, v: V, p: Sigma<&2, &2, HsMap<K, V>, _ => HsMap<K, V>>) -> Sigma<&2, &2, HsMap<K, V>, _ => HsMap<K, V>>:\n  match p:\n    case (a, b):\n      (HsMap.Bin{k, v, a}, b)\n\n# split k m: the pairs whose key is below k, and those above it\ndef HsMap.split(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +k: K, m: HsMap<K, V>) -> Sigma<&2, &2, HsMap<K, V>, _ => HsMap<K, V>>:\n  match m:\n    case HsMap.Tip{}:\n      (HsMap.Tip{}, HsMap.Tip{})\n    case HsMap.Bin{+k2, +v2, +t}:\n      HsCmp.on(Sigma<&2, &2, HsMap<K, V>, _ => HsMap<K, V>>, cmp(k2, k), _ => HsMap.split.below(~K, ~V, k2, v2, HsMap.split(~K, ~V, ~cmp, k, t)), _ => (HsMap.Tip{}, t), _ => (HsMap.Tip{}, HsMap.Bin{k2, v2, t}))\n\n# intersection a b: a's keys b holds\ndef HsSet.intersection(~K: Data, ~cmp: K -> K -> Cmp, a: HsSet<K>, +b: HsSet<K>) -> HsSet<K>:\n  match a:\n    case HsSet.Tip{}:\n      HsSet.Tip{}\n    case HsSet.Bin{+k, +t}:\n      HsBool.if(HsSet<K>, HsSet.member(~K, ~cmp, k, b), _ => HsSet.Bin{k, HsSet.intersection(~K, ~cmp, t, b)}, _ => HsSet.intersection(~K, ~cmp, t, b))\n\n# Data.Map's and Data.Set's size: an Int, which is HsInt (Spec's rewrite)\ndef HsMap.isize(~K: Data, ~V: Data, m: HsMap<K, V>) -> HsInt:\n  HsInt.Pos{HsMap.size(~K, ~V, m)}\n\ndef HsSet.isize(~K: Data, s: HsSet<K>) -> HsInt:\n  HsInt.Pos{HsSet.size(~K, s)}\n\n# fromDistinctAscList: the pairs as they are (ascending and distinct, its\n# caller's word, as containers takes it)\ndef HsMap.fromAsc(~K: Data, ~V: Data, xs: List<&2, Sigma<&2, &2, K, _ => V>>) -> HsMap<K, V>:\n  match xs:\n    case Nil{}:\n      HsMap.Tip{}\n    case (k, v) <> t:\n      HsMap.Bin{k, v, HsMap.fromAsc(~K, ~V, t)}\n\n# unions ms: the maps' union, the first's values first\ndef HsMap.unions(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ms: List<&2, HsMap<K, V>>) -> HsMap<K, V>:\n  HsMap.unionsWith(~K, ~V, ~cmp, ~(a => b => a), ms)\n"

def pre.HsMapMore() -> String:
  pre.HsMapMore.p0() ++ pre.HsMapMore.p1()
def pre.HsMonad.p0() -> String:
  "# Control.Monad's list functions at Either e and at Maybe (Fold.bend's\n# fd.mapm.at and fd.mlist.at; State's and ExceptT-over-State's are in each\n# module's prelude, fd.pre.state and fd.pre.exs): mapM_ (forM_, traverse_),\n# mapM (forM, traverse), sequence (sequenceA), foldM, filterM and zipWithM_\n# at a list. The answer\n# is GHC's: the first Left (Nothing) in the list's order, else the values.\n# Bend computes a call's arguments first, so the rest of the list is walked\n# even after a Left (a match takes no computed value): the same answer,\n# more work.\n\n# x's Left, else rest\ndef HsList.either.then(~E: Data, ~B: Data, ~C: Data, r: Either<&2, &2, E, B>, rest: Either<&2, &2, E, C>) -> Either<&2, &2, E, C>:\n  match r:\n    case Inl{e}:\n      Inl{e}\n    case Inr{b}:\n      rest\n\ndef HsList.either.cons(~E: Data, ~B: Data, r: Either<&2, &2, E, B>, rest: Either<&2, &2, E, List<&2, B>>) -> Either<&2, &2, E, List<&2, B>>:\n  match r rest:\n    case Inl{e} _:\n      Inl{e}\n    case Inr{b} Inl{e}:\n      Inl{e}\n    case Inr{b} Inr{bs}:\n      Inr{b <> bs}\n\ndef HsList.keep(~A: Data, k: Bool, x: A, ys: List<&2, A>) -> List<&2, A>:\n  match k:\n    case True{}:\n      x <> ys\n    case False{}:\n      ys\n\ndef HsList.either.keep(~E: Data, ~A: Data, x: A, r: Either<&2, &2, E, Bool>, rest: Either<&2, &2, E, List<&2, A>>) -> Either<&2, &2, E, List<&2, A>>:\n  match r rest:\n    case Inl{e} _:\n      Inl{e}\n    case Inr{k} Inl{e}:\n      Inl{e}\n    case Inr{k} Inr{ys}:\n      Inr{HsList.keep(~A, k, x, ys)}\n\ndef HsList.either.mapm_(~E: Data, ~A: Data, ~B: Data, ~f: A -> Either<&2, &2, E, B>, xs: List<&2, A>) -> Either<&2, &2, E, Unit>:\n  match xs:\n    case Nil{}:\n      Inr{Unit{}}\n    case +h <> t:\n      HsList.either.then(~E, ~B, ~Unit, f(h), HsList.either.mapm_(~E, ~A, ~B, ~f, t))\n\ndef HsList.either.mapm(~E: Data, ~A: Data, ~B: Data, ~f: A -> Either<&2, &2, E, B>, xs: List<&2, A>) -> Either<&2, &2, E, List<&2, B>>:\n  match xs:\n    case Nil{}:\n      Inr{Nil{}}\n    case +h <> t:\n      HsList.either.cons(~E, ~B, f(h), HsList.either.mapm(~E, ~A, ~B, ~f, t))\n\n# sequence (sequenceA) at a list: mapM id\ndef HsList.either.seq(~E: Data, ~B: Data, xs: List<&2, Either<&2, &2, E, B>>) -> Either<&2, &2, E, List<&2, B>>:\n  match xs:\n    case Nil{}:\n      Inr{Nil{}}\n    case h <> t:\n      HsList.either.cons(~E, ~B, h, HsList.either.seq(~E, ~B, t))\n\ndef HsList.either.step(~E: Data, ~A: Data, ~B: Data, ~f: B -> A -> Either<&2, &2, E, B>, acc: Either<&2, &2, E, B>, +h: A) -> Either<&2, &2, E, B>:\n  match acc:\n    case Inl{e}:\n      Inl{e}\n    case Inr{+z}:\n      f(z)(h)\n\ndef HsList.either.foldm.go(~E: Data, ~A: Data, ~B: Data, ~f: B -> A -> Either<&2, &2, E, B>, xs: List<&2, A>, acc: Either<&2, &2, E, B>) -> Either<&2, &2, E, B>:\n"

def pre.HsMonad.p1() -> String:
  "  match xs:\n    case Nil{}:\n      acc\n    case h <> t:\n      HsList.either.foldm.go(~E, ~A, ~B, ~f, t, HsList.either.step(~E, ~A, ~B, ~f, acc, h))\n\ndef HsList.either.foldm(~E: Data, ~A: Data, ~B: Data, ~f: B -> A -> Either<&2, &2, E, B>, xs: List<&2, A>, z: B) -> Either<&2, &2, E, B>:\n  HsList.either.foldm.go(~E, ~A, ~B, ~f, xs, Inr{z})\n\ndef HsList.either.filterm(~E: Data, ~A: Data, ~p: A -> Either<&2, &2, E, Bool>, xs: List<&2, A>) -> Either<&2, &2, E, List<&2, A>>:\n  match xs:\n    case Nil{}:\n      Inr{Nil{}}\n    case +h <> t:\n      HsList.either.keep(~E, ~A, h, p(h), HsList.either.filterm(~E, ~A, ~p, t))\n\ndef HsList.either.zipwithm_(~E: Data, ~A: Data, ~B: Data, ~C: Data, ~f: A -> B -> Either<&2, &2, E, C>, xs: List<&2, A>, ys: List<&2, B>) -> Either<&2, &2, E, Unit>:\n  match xs ys:\n    case +x <> xt +y <> yt:\n      HsList.either.then(~E, ~C, ~Unit, f(x)(y), HsList.either.zipwithm_(~E, ~A, ~B, ~C, ~f, xt, yt))\n    case _ _:\n      Inr{Unit{}}\n\n# at Maybe\ndef HsList.maybe.then(~B: Data, ~C: Data, r: Maybe<&2, B>, rest: Maybe<&2, C>) -> Maybe<&2, C>:\n  match r:\n    case None{}:\n      None{}\n    case Some{b}:\n      rest\n\ndef HsList.maybe.cons(~B: Data, r: Maybe<&2, B>, rest: Maybe<&2, List<&2, B>>) -> Maybe<&2, List<&2, B>>:\n  match r rest:\n    case None{} _:\n      None{}\n    case Some{b} None{}:\n      None{}\n    case Some{b} Some{bs}:\n      Some{b <> bs}\n\ndef HsList.maybe.keep(~A: Data, x: A, r: Maybe<&2, Bool>, rest: Maybe<&2, List<&2, A>>) -> Maybe<&2, List<&2, A>>:\n  match r rest:\n    case None{} _:\n      None{}\n    case Some{k} None{}:\n      None{}\n    case Some{k} Some{ys}:\n      Some{HsList.keep(~A, k, x, ys)}\n\ndef HsList.maybe.mapm_(~A: Data, ~B: Data, ~f: A -> Maybe<&2, B>, xs: List<&2, A>) -> Maybe<&2, Unit>:\n  match xs:\n    case Nil{}:\n      Some{Unit{}}\n    case +h <> t:\n      HsList.maybe.then(~B, ~Unit, f(h), HsList.maybe.mapm_(~A, ~B, ~f, t))\n\ndef HsList.maybe.mapm(~A: Data, ~B: Data, ~f: A -> Maybe<&2, B>, xs: List<&2, A>) -> Maybe<&2, List<&2, B>>:\n  match xs:\n    case Nil{}:\n      Some{Nil{}}\n    case +h <> t:\n      HsList.maybe.cons(~B, f(h), HsList.maybe.mapm(~A, ~B, ~f, t))\n\n# sequence (sequenceA) at a list: mapM id\ndef HsList.maybe.seq(~B: Data, xs: List<&2, Maybe<&2, B>>) -> Maybe<&2, List<&2, B>>:\n  match xs:\n    case Nil{}:\n      Some{Nil{}}\n    case h <> t:\n      HsList.maybe.cons(~B, h, HsList.maybe.seq(~B, t))\n\ndef HsList.maybe.step(~A: Data, ~B: Data, ~f: B -> A -> Maybe<&2, B>, acc: Maybe<&2, B>, +h: A) -> Maybe<&2, B>:\n  match acc:\n    case None{}:\n      None{}\n    case Some{+z}:\n      f(z)(h)\n\ndef HsList.maybe.foldm.go(~A: Data, ~B: Data, ~f: B -> A -> Maybe<&2, B>, xs: List<&2, A>, acc: Maybe<&2, B>) -> Maybe<&2, B>:\n  match xs:\n"

def pre.HsMonad.p2() -> String:
  "    case Nil{}:\n      acc\n    case h <> t:\n      HsList.maybe.foldm.go(~A, ~B, ~f, t, HsList.maybe.step(~A, ~B, ~f, acc, h))\n\ndef HsList.maybe.foldm(~A: Data, ~B: Data, ~f: B -> A -> Maybe<&2, B>, xs: List<&2, A>, z: B) -> Maybe<&2, B>:\n  HsList.maybe.foldm.go(~A, ~B, ~f, xs, Some{z})\n\ndef HsList.maybe.filterm(~A: Data, ~p: A -> Maybe<&2, Bool>, xs: List<&2, A>) -> Maybe<&2, List<&2, A>>:\n  match xs:\n    case Nil{}:\n      Some{Nil{}}\n    case +h <> t:\n      HsList.maybe.keep(~A, h, p(h), HsList.maybe.filterm(~A, ~p, t))\n\ndef HsList.maybe.zipwithm_(~A: Data, ~B: Data, ~C: Data, ~f: A -> B -> Maybe<&2, C>, xs: List<&2, A>, ys: List<&2, B>) -> Maybe<&2, Unit>:\n  match xs ys:\n    case +x <> xt +y <> yt:\n      HsList.maybe.then(~C, ~Unit, f(x)(y), HsList.maybe.zipwithm_(~A, ~B, ~C, ~f, xt, yt))\n    case _ _:\n      Some{Unit{}}\n"

def pre.HsMonad() -> String:
  pre.HsMonad.p0() ++ pre.HsMonad.p1() ++ pre.HsMonad.p2()
def pre.HsOrd.p0() -> String:
  "# Data.Ord's comparing: an Ord's compare on a key (Fold.bend's\n# fd.bftab2.ord; the survey had it as base it maps, the fold had not)\ndef HsList.comparing(~K: Data, ~A: Data, ~cmp: K -> K -> Cmp, ~f: A -> K, x: A, y: A) -> Cmp:\n  cmp(f(x))(f(y))\n\n# Integral's even and odd at Int (Fold.bend's BfParity)\ndef HsInt.even(+x: HsInt) -> Bool:\n  HsInt.is_eq(HsInt.rem(x, HsInt.Pos{2n}), HsInt.Pos{0n})\n\ndef HsInt.odd(+x: HsInt) -> Bool:\n  Bool.not(HsInt.even(x))\n\n# compare at Either, Ordering, a Map and a Set (Data.Map's and Data.Set's\n# Ord: their lists in ascending order), and max and min by a compare\n# (Haskell's defaults: max x y = if x <= y then y else x)\ndef HsCmp.either(~A: Data, ~B: Data, ~ca: A -> A -> Cmp, ~cb: B -> B -> Cmp, a: Either<&2, &2, A, B>, b: Either<&2, &2, A, B>) -> Cmp:\n  match a b:\n    case Inl{x} Inl{y}:\n      ca(x)(y)\n    case Inl{x} Inr{y}:\n      LT{}\n    case Inr{x} Inl{y}:\n      GT{}\n    case Inr{x} Inr{y}:\n      cb(x)(y)\n\ndef HsCmp.cmp(a: Cmp, b: Cmp) -> Cmp:\n  match a b:\n    case LT{} LT{}:\n      EQ{}\n    case LT{} _:\n      LT{}\n    case _ LT{}:\n      GT{}\n    case EQ{} EQ{}:\n      EQ{}\n    case EQ{} _:\n      LT{}\n    case _ EQ{}:\n      GT{}\n    case GT{} GT{}:\n      EQ{}\n\ndef HsCmp.map(~K: Data, ~V: Data, ~ck: K -> K -> Cmp, ~cv: V -> V -> Cmp, a: HsMap<K, V>, b: HsMap<K, V>) -> Cmp:\n  match a b:\n    case HsMap.Tip{} HsMap.Tip{}:\n      EQ{}\n    case HsMap.Tip{} _:\n      LT{}\n    case _ HsMap.Tip{}:\n      GT{}\n    case HsMap.Bin{k1, v1, r1} HsMap.Bin{k2, v2, r2}:\n      HsCmp.on(Cmp, ck(k1)(k2), _ => LT{}, _ => HsCmp.on(Cmp, cv(v1)(v2), _ => LT{}, _ => HsCmp.map(~K, ~V, ~ck, ~cv, r1, r2), _ => GT{}), _ => GT{})\n\ndef HsCmp.set(~K: Data, ~ck: K -> K -> Cmp, a: HsSet<K>, b: HsSet<K>) -> Cmp:\n  match a b:\n    case HsSet.Tip{} HsSet.Tip{}:\n      EQ{}\n    case HsSet.Tip{} _:\n      LT{}\n    case _ HsSet.Tip{}:\n      GT{}\n    case HsSet.Bin{k1, r1} HsSet.Bin{k2, r2}:\n      HsCmp.on(Cmp, ck(k1)(k2), _ => LT{}, _ => HsCmp.set(~K, ~ck, r1, r2), _ => GT{})\n\ndef HsCmp.max(~A: Data, ~cmp: A -> A -> Cmp, +a: A, +b: A) -> A:\n  Bool.pick(A, Cmp.is_le(cmp(a)(b)), b, a)\n\ndef HsCmp.min(~A: Data, ~cmp: A -> A -> Cmp, +a: A, +b: A) -> A:\n  Bool.pick(A, Cmp.is_le(cmp(a)(b)), a, b)\n"

def pre.HsOrd() -> String:
  pre.HsOrd.p0()
def pre.HsPartial.p0() -> String:
  "# Haskell's partial functions as failure values (PLAN.md, \"Partial\n# functions\"): each answers Either<&2, &2, String, A>, Inl{GHC's message}\n# where GHC throws its ErrorCall (the message alone: GHC keeps the call\n# stack apart), Inr{the answer} else. A def that calls one answers such an\n# Either itself, its partial calls bound with hs.either.bind (Fold.bend's\n# partial pass, fd.pt).\n\n# error and errorWithoutStackTrace\ndef HsList.error(~A: Data, msg: List<&2, Char>) -> Either<&2, &2, List<&2, Char>, A>:\n  Inl{msg}\n\ndef HsList.undefined(~A: Data) -> Either<&2, &2, List<&2, Char>, A>:\n  Inl{String.to_list(\"Prelude.undefined\")}\n\ndef HsList.head(~A: Data, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, A>:\n  match xs:\n    case Nil{}:\n      Inl{String.to_list(\"Prelude.head: empty list\")}\n    case x <> t:\n      Inr{x}\n\ndef HsList.tail(~A: Data, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, List<&2, A>>:\n  match xs:\n    case Nil{}:\n      Inl{String.to_list(\"Prelude.tail: empty list\")}\n    case x <> t:\n      Inr{t}\n\ndef HsList.last.go(~A: Data, xs: List<&2, A>, x: A) -> A:\n  match xs:\n    case Nil{}:\n      x\n    case y <> t:\n      HsList.last.go(~A, t, y)\n\ndef HsList.last(~A: Data, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, A>:\n  match xs:\n    case Nil{}:\n      Inl{String.to_list(\"Prelude.last: empty list\")}\n    case x <> t:\n      Inr{HsList.last.go(~A, t, x)}\n\ndef HsList.init.go(~A: Data, xs: List<&2, A>, x: A) -> List<&2, A>:\n  match xs:\n    case Nil{}:\n      Nil{}\n    case y <> t:\n      x <> HsList.init.go(~A, t, y)\n\ndef HsList.init(~A: Data, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, List<&2, A>>:\n  match xs:\n    case Nil{}:\n      Inl{String.to_list(\"Prelude.init: empty list\")}\n    case x <> t:\n      Inr{HsList.init.go(~A, t, x)}\n\n# xs !! n\ndef HsList.index.go(~A: Data, xs: List<&2, A>, n: Nat) -> Either<&2, &2, List<&2, Char>, A>:\n  match xs n:\n    case Nil{} _:\n      Inl{String.to_list(\"Prelude.!!: index too large\")}\n    case x <> t 0n:\n      Inr{x}\n    case x <> t 1n+k:\n      HsList.index.go(~A, t, k)\n\ndef HsList.index(~A: Data, xs: List<&2, A>, n: HsInt) -> Either<&2, &2, List<&2, Char>, A>:\n  match n:\n    case HsInt.Pos{k}:\n      HsList.index.go(~A, xs, k)\n    case HsInt.Neg{k}:\n      Inl{String.to_list(\"Prelude.!!: negative index\")}\n\ndef HsList.fromJust(~A: Data, m: Maybe<&2, A>) -> Either<&2, &2, List<&2, Char>, A>:\n  match m:\n    case None{}:\n      Inl{String.to_list(\"Maybe.fromJust: Nothing\")}\n    case Some{x}:\n      Inr{x}\n\n# Data.Map's m ! k\ndef HsMap.at(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, m: HsMap<K, V>, +k: K) -> Either<&2, &2, List<&2, Char>, V>:\n  match m:\n    case HsMap.Tip{}:\n"

def pre.HsPartial.p1() -> String:
  "      Inl{String.to_list(\"Map.!: given key is not an element in the map\")}\n    case HsMap.Bin{+k2, +v2, +t}:\n      HsCmp.on(Either<&2, &2, List<&2, Char>, V>, cmp(k, k2), _ => Inl{String.to_list(\"Map.!: given key is not an element in the map\")}, _ => Inr{v2}, _ => HsMap.at(~K, ~V, ~cmp, t, k))\n\n# maximum and minimum (Foldable's, at a list): Ord's max and min, so of two\n# equal elements maximum keeps the later one and minimum the earlier one.\n# Foldable's maximumBy and minimumBy keep the same ones, with their own\n# message.\ndef HsList.maximum.go(~A: Data, ~cmp: A -> A -> Cmp, xs: List<&2, A>, +x: A) -> A:\n  match xs:\n    case Nil{}:\n      x\n    case +y <> t:\n      HsList.maximum.go(~A, ~cmp, t, HsCmp.on(A, cmp(x)(y), _ => y, _ => y, _ => x))\n\ndef HsList.minimum.go(~A: Data, ~cmp: A -> A -> Cmp, xs: List<&2, A>, +x: A) -> A:\n  match xs:\n    case Nil{}:\n      x\n    case +y <> t:\n      HsList.minimum.go(~A, ~cmp, t, HsCmp.on(A, cmp(x)(y), _ => x, _ => x, _ => y))\n\ndef HsList.maximum(~A: Data, ~cmp: A -> A -> Cmp, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, A>:\n  match xs:\n    case Nil{}:\n      Inl{String.to_list(\"Prelude.maximum: empty list\")}\n    case x <> t:\n      Inr{HsList.maximum.go(~A, ~cmp, t, x)}\n\ndef HsList.minimum(~A: Data, ~cmp: A -> A -> Cmp, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, A>:\n  match xs:\n    case Nil{}:\n      Inl{String.to_list(\"Prelude.minimum: empty list\")}\n    case x <> t:\n      Inr{HsList.minimum.go(~A, ~cmp, t, x)}\n\ndef HsList.maximumBy(~A: Data, ~cmp: A -> A -> Cmp, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, A>:\n  match xs:\n    case Nil{}:\n      Inl{String.to_list(\"maximumBy: empty structure\")}\n    case x <> t:\n      Inr{HsList.maximum.go(~A, ~cmp, t, x)}\n\ndef HsList.minimumBy(~A: Data, ~cmp: A -> A -> Cmp, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, A>:\n  match xs:\n    case Nil{}:\n      Inl{String.to_list(\"minimumBy: empty structure\")}\n    case x <> t:\n      Inr{HsList.minimum.go(~A, ~cmp, t, x)}\n\n# foldr1 and foldl1 (Foldable's, at a list)\ndef HsList.foldr1.go(~A: Data, ~f: A -> A -> A, xs: List<&2, A>, +x: A) -> A:\n  match xs:\n    case Nil{}:\n      x\n    case +y <> t:\n      +r = HsList.foldr1.go(~A, ~f, t, y)\n      f(x, r)\n\ndef HsList.foldl1.go(~A: Data, ~f: A -> A -> A, xs: List<&2, A>, +acc: A) -> A:\n  match xs:\n    case Nil{}:\n      acc\n    case +y <> t:\n      HsList.foldl1.go(~A, ~f, t, f(acc, y))\n\ndef HsList.foldr1(~A: Data, ~f: A -> A -> A, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, A>:\n  match xs:\n    case Nil{}:\n      Inl{String.to_list(\"Prelude.foldr1: empty list\")}\n    case x <> t:\n      Inr{HsList.foldr1.go(~A, ~f, t, x)}\n\n"

def pre.HsPartial.p2() -> String:
  "def HsList.foldl1(~A: Data, ~f: A -> A -> A, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, A>:\n  match xs:\n    case Nil{}:\n      Inl{String.to_list(\"Prelude.foldl1: empty list\")}\n    case x <> t:\n      Inr{HsList.foldl1.go(~A, ~f, t, x)}\n\n# div, mod, quot and rem by a divisor that is not a known non-zero\n# literal (Fold.bend's fd.num): GHC throws ArithException DivideByZero,\n# shown \"divide by zero\", at 0, so these answer it there (Base's Nat.div\n# and Nat.mod answer 0 and a: F was more defined than Haskell, and no left\n# adjoint, adj/PROOF.bend's P.tot.not).  At Nat (Natural, and Int and\n# Integer where nothing subtracts) quot is div and rem is mod.\ndef HsNum.div(a: Nat, b: Nat) -> Either<&2, &2, List<&2, Char>, Nat>:\n  match b:\n    case 0n:\n      Inl{String.to_list(\"divide by zero\")}\n    case 1n+q:\n      Inr{Nat.div(a, 1n+q)}\n\ndef HsNum.mod(a: Nat, b: Nat) -> Either<&2, &2, List<&2, Char>, Nat>:\n  match b:\n    case 0n:\n      Inl{String.to_list(\"divide by zero\")}\n    case 1n+q:\n      Inr{Nat.mod(a, 1n+q)}\n\n# Natural's (-), below 0 GHC's ArithException Underflow (Spec writes the\n# method at Natural HsPrelude.N.natSub, in a module alone and in a package)\ndef HsNum.sub(a: Nat, b: Nat) -> Either<&2, &2, List<&2, Char>, Nat>:\n  match a b:\n    case 0n 0n:\n      Inr{0n}\n    case 0n 1n+q:\n      Inl{String.to_list(\"arithmetic underflow\")}\n    case 1n+p 0n:\n      Inr{1n+p}\n    case 1n+p 1n+q:\n      HsNum.sub(p, q)\n\n# at HsInt (Int and Integer): 0 is Pos{0n} only\ndef HsNum.idiv(a: HsInt, b: HsInt) -> Either<&2, &2, List<&2, Char>, HsInt>:\n  match b:\n    case HsInt.Pos{0n}:\n      Inl{String.to_list(\"divide by zero\")}\n    case c:\n      Inr{HsInt.div(a, c)}\n\ndef HsNum.imod(a: HsInt, b: HsInt) -> Either<&2, &2, List<&2, Char>, HsInt>:\n  match b:\n    case HsInt.Pos{0n}:\n      Inl{String.to_list(\"divide by zero\")}\n    case c:\n      Inr{HsInt.mod(a, c)}\n\ndef HsNum.iquot(a: HsInt, b: HsInt) -> Either<&2, &2, List<&2, Char>, HsInt>:\n  match b:\n    case HsInt.Pos{0n}:\n      Inl{String.to_list(\"divide by zero\")}\n    case c:\n      Inr{HsInt.quot(a, c)}\n\ndef HsNum.irem(a: HsInt, b: HsInt) -> Either<&2, &2, List<&2, Char>, HsInt>:\n  match b:\n    case HsInt.Pos{0n}:\n      Inl{String.to_list(\"divide by zero\")}\n    case c:\n      Inr{HsInt.rem(a, c)}\n\n# x / y at Rational: GHC throws ArithException RatioZeroDenominator, shown\n# \"Ratio has zero denominator\", at 0 (HsRational.div answers 0 there)\ndef HsNum.rdiv(a: HsRational, b: HsRational) -> Either<&2, &2, List<&2, Char>, HsRational>:\n  match b:\n    case HsRational{HsInt.Pos{0n}, q}:\n      Inl{String.to_list(\"Ratio has zero denominator\")}\n    case c:\n      Inr{HsRational.div(a, c)}\n\n"

def pre.HsPartial.p3() -> String:
  "# The list functions given a partial function, one that answers the Either\n# (Fold.bend's fd.pt.ho): the first failure, left to right (foldr's from\n# the right), any and all stopping as Haskell's do.\ndef HsPt.bind(-A: Data, -B: Data, m: Either<&2, &2, List<&2, Char>, A>, k: A -> Either<&2, &2, List<&2, Char>, B>) -> Either<&2, &2, List<&2, Char>, B>:\n  match m:\n    case Inl{e}:\n      Inl{e}\n    case Inr{a}:\n      k(a)\n\ndef HsPt.map(~A: Data, ~B: Data, ~f: A -> Either<&2, &2, List<&2, Char>, B>, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, List<&2, B>>:\n  match xs:\n    case Nil{}:\n      Inr{[]}\n    case +x <> t:\n      HsPt.bind(B, List<&2, B>, f(x), b => HsPt.bind(List<&2, B>, List<&2, B>, HsPt.map(~A, ~B, ~f, t), bs => Inr{b <> bs}))\n\ndef HsPt.foldr(~A: Data, ~B: Data, ~f: A -> B -> Either<&2, &2, List<&2, Char>, B>, xs: List<&2, A>, z: B) -> Either<&2, &2, List<&2, Char>, B>:\n  match xs:\n    case Nil{}:\n      Inr{z}\n    case +x <> t:\n      HsPt.bind(B, B, HsPt.foldr(~A, ~B, ~f, t, z), +r => f(x)(r))\n\ndef HsPt.foldl(~A: Data, ~B: Data, ~f: B -> A -> Either<&2, &2, List<&2, Char>, B>, xs: List<&2, A>, +acc: B) -> Either<&2, &2, List<&2, Char>, B>:\n  match xs:\n    case Nil{}:\n      Inr{acc}\n    case +x <> t:\n      HsPt.bind(B, B, f(acc)(x), r => HsPt.foldl(~A, ~B, ~f, t, r))\n\ndef HsPt.keep(-A: Data, x: A, k: Bool, r: List<&2, A>) -> List<&2, A>:\n  match k:\n    case True{}:\n      x <> r\n    case False{}:\n      r\n\ndef HsPt.filter(~A: Data, ~p: A -> Either<&2, &2, List<&2, Char>, Bool>, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, List<&2, A>>:\n  match xs:\n    case Nil{}:\n      Inr{[]}\n    case +x <> t:\n      HsPt.bind(Bool, List<&2, A>, p(x), k => HsPt.bind(List<&2, A>, List<&2, A>, HsPt.filter(~A, ~p, t), r => Inr{HsPt.keep(A, x, k, r)}))\n\ndef HsPt.stop(v: Bool, at: Bool, rest: Unit -> Either<&2, &2, List<&2, Char>, Bool>) -> Either<&2, &2, List<&2, Char>, Bool>:\n  match v at:\n    case True{} True{}:\n      Inr{True{}}\n    case False{} False{}:\n      Inr{False{}}\n    case _ _:\n      rest(Unit{})\n\ndef HsPt.any(~a: Quant, ~A: Data, ~p: A -> Either<&2, &2, List<&2, Char>, Bool>, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, Bool>:\n  match xs:\n    case Nil{}:\n      Inr{False{}}\n    case +x <> t:\n      HsPt.bind(Bool, Bool, p(x), v => HsPt.stop(v, True{}, _ => HsPt.any(~a, ~A, ~p, t)))\n\ndef HsPt.all(~a: Quant, ~A: Data, ~p: A -> Either<&2, &2, List<&2, Char>, Bool>, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, Bool>:\n  match xs:\n    case Nil{}:\n      Inr{True{}}\n    case +x <> t:\n      HsPt.bind(Bool, Bool, p(x), v => HsPt.stop(v, False{}, _ => HsPt.all(~a, ~A, ~p, t)))\n\n"

def pre.HsPartial.p4() -> String:
  "def HsPt.zipWith(~A: Data, ~B: Data, ~C: Data, ~f: A -> B -> Either<&2, &2, List<&2, Char>, C>, xs: List<&2, A>, ys: List<&2, B>) -> Either<&2, &2, List<&2, Char>, List<&2, C>>:\n  match xs ys:\n    case Nil{} _:\n      Inr{[]}\n    case _ Nil{}:\n      Inr{[]}\n    case +x <> t +y <> u:\n      HsPt.bind(C, List<&2, C>, f(x)(y), c => HsPt.bind(List<&2, C>, List<&2, C>, HsPt.zipWith(~A, ~B, ~C, ~f, t, u), cs => Inr{c <> cs}))\n\ndef HsPt.maybe(-B: Data, m: Maybe<&2, B>, r: List<&2, B>) -> List<&2, B>:\n  match m:\n    case Some{b}:\n      b <> r\n    case None{}:\n      r\n\ndef HsPt.mapMaybe(~A: Data, ~B: Data, ~f: A -> Either<&2, &2, List<&2, Char>, Maybe<&2, B>>, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, List<&2, B>>:\n  match xs:\n    case Nil{}:\n      Inr{[]}\n    case +x <> t:\n      HsPt.bind(Maybe<&2, B>, List<&2, B>, f(x), m => HsPt.bind(List<&2, B>, List<&2, B>, HsPt.mapMaybe(~A, ~B, ~f, t), r => Inr{HsPt.maybe(B, m, r)}))\n\n# A partial call's bind where an answer is no Data (an action's result, a\n# pair of &1s), at its quantities\ndef HsPt.bindq(-p: Quant, -q: Quant, -A: Kind(p), -B: Kind(q), m: Either<&2, p, List<&2, Char>, A>, k: A -> Either<&2, q, List<&2, Char>, B>) -> Either<&2, q, List<&2, Char>, B>:\n  match m:\n    case Inl{e}:\n      Inl{e}\n    case Inr{a}:\n      k(a)\n\n# The monads' binds and maps and Haskell's maybe and either given a partial\n# function (Fold.bend's fd.pt.hoq): an action's continuation answers the\n# Either at the state it is given (a partial action's answer is an Either\n# at each state: fd.pa)\ndef HsPt.exs.bind.go(-E: Data, -S: Data, -A: Data, -B: Data, r: Either<&2, &2, E, A>, f: A -> S -> Either<&2, &1, List<&2, Char>, Sigma<&1, &1, Either<&2, &2, E, B>, _ => S>>, s: S) -> Either<&2, &1, List<&2, Char>, Sigma<&1, &1, Either<&2, &2, E, B>, _ => S>>:\n  match r:\n    case Inl{e}:\n      Inr{(Inl{e}, s)}\n    case Inr{a}:\n      f(a)(s)\n\ndef HsPt.exs.bind(-E: Data, -S: Data, -A: Data, -B: Data, p: Sigma<&1, &1, Either<&2, &2, E, A>, _ => S>, f: A -> S -> Either<&2, &1, List<&2, Char>, Sigma<&1, &1, Either<&2, &2, E, B>, _ => S>>) -> Either<&2, &1, List<&2, Char>, Sigma<&1, &1, Either<&2, &2, E, B>, _ => S>>:\n  (r, s) = p\n  HsPt.exs.bind.go(E, S, A, B, r, f, s)\n\ndef HsPt.exs.map.go(-E: Data, -S: Data, -A: Data, -B: Data, f: A -> Either<&2, &2, List<&2, Char>, B>, r: Either<&2, &2, E, A>, s: S) -> Either<&2, &1, List<&2, Char>, Sigma<&1, &1, Either<&2, &2, E, B>, _ => S>>:\n  match r:\n    case Inl{e}:\n      Inr{(Inl{e}, s)}\n    case Inr{a}:\n      HsPt.bindq(&2, &1, B, Sigma<&1, &1, Either<&2, &2, E, B>, _ => S>, f(a), b => Inr{(Inr{b}, s)})\n\n"

def pre.HsPartial.p5() -> String:
  "def HsPt.exs.map(-E: Data, -S: Data, -A: Data, -B: Data, f: A -> Either<&2, &2, List<&2, Char>, B>, p: Sigma<&1, &1, Either<&2, &2, E, A>, _ => S>) -> Either<&2, &1, List<&2, Char>, Sigma<&1, &1, Either<&2, &2, E, B>, _ => S>>:\n  (r, s) = p\n  HsPt.exs.map.go(E, S, A, B, f, r, s)\n\n# a function's action and its argument's (State's <*>)\ndef HsPt.state.ap.fin(-S: Data, -A: Type, -B: Type, f: A -> B, q: Sigma<&1, &1, A, _ => S>) -> Either<&2, &1, List<&2, Char>, Sigma<&1, &1, B, _ => S>>:\n  (a, s) = q\n  Inr{(f(a), s)}\n\ndef HsPt.state.ap(-S: Data, -A: Type, -B: Type, p: Sigma<&1, &1, (A -> B), _ => S>, m: S -> Either<&2, &1, List<&2, Char>, Sigma<&1, &1, A, _ => S>>) -> Either<&2, &1, List<&2, Char>, Sigma<&1, &1, B, _ => S>>:\n  (f, s) = p\n  HsPt.bindq(&1, &1, Sigma<&1, &1, A, _ => S>, Sigma<&1, &1, B, _ => S>, m(s), q => HsPt.state.ap.fin(S, A, B, f, q))\n\n# StateT over Either (hs.ste.*): its step is an Either already\ndef HsPt.ste.bind(-E: Data, -S: Data, -A: Data, -B: Data, r: Either<&2, &2, E, Sigma<&2, &2, A, _ => S>>, f: A -> S -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, Sigma<&2, &2, B, _ => S>>>) -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, Sigma<&2, &2, B, _ => S>>>:\n  match r:\n    case Inl{e}:\n      Inr{Inl{e}}\n    case Inr{Tuple{a, s}}:\n      f(a)(s)\n\ndef HsPt.ste.map.go(-E: Data, -S: Data, -A: Data, -B: Data, f: A -> Either<&2, &2, List<&2, Char>, B>, r: Either<&2, &2, E, Sigma<&2, &2, A, _ => S>>) -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, Sigma<&2, &2, B, _ => S>>>:\n  match r:\n    case Inl{e}:\n      Inr{Inl{e}}\n    case Inr{Tuple{a, s}}:\n      HsPt.bind(B, Either<&2, &2, E, Sigma<&2, &2, B, _ => S>>, f(a), b => Inr{Inr{Tuple{b, s}}})\n\ndef HsPt.ste.map(-E: Data, -S: Data, -A: Data, -B: Data, f: A -> Either<&2, &2, List<&2, Char>, B>, r: Either<&2, &2, E, Sigma<&2, &2, A, _ => S>>) -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, Sigma<&2, &2, B, _ => S>>>:\n  HsPt.ste.map.go(E, S, A, B, f, r)\n\ndef HsPt.ste.gets(-E: Data, -S: Data, -A: Data, f: S -> Either<&2, &2, List<&2, Char>, A>, +s: S) -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, Sigma<&2, &2, A, _ => S>>>:\n  HsPt.bind(A, Either<&2, &2, E, Sigma<&2, &2, A, _ => S>>, f(s), a => Inr{Inr{Tuple{a, s}}})\n\ndef HsPt.state.gets(-S: Data, -A: Data, f: S -> Either<&2, &2, List<&2, Char>, A>, +s: S) -> Either<&2, &1, List<&2, Char>, Sigma<&1, &1, A, _ => S>>:\n  HsPt.bindq(&2, &1, A, Sigma<&1, &1, A, _ => S>, f(s), a => Inr{(a, s)})\n\n# ReaderT over Either (hs.rde.*)\ndef HsPt.rde.bind(-R: Data, -E: Data, -A: Data, -B: Data, x: Either<&2, &2, E, A>, f: A -> R -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, B>>, r: R) -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, B>>:\n  match x:\n    case Inl{e}:\n      Inr{Inl{e}}\n"

def pre.HsPartial.p6() -> String:
  "    case Inr{a}:\n      f(a)(r)\n\ndef HsPt.rde.map(-R: Data, -E: Data, -A: Data, -B: Data, f: A -> Either<&2, &2, List<&2, Char>, B>, x: Either<&2, &2, E, A>) -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, B>>:\n  match x:\n    case Inl{e}:\n      Inr{Inl{e}}\n    case Inr{a}:\n      HsPt.bind(B, Either<&2, &2, E, B>, f(a), b => Inr{Inr{b}})\n\ndef HsPt.state.bind(-S: Data, -A: Type, -B: Type, p: Sigma<&1, &1, A, _ => S>, f: A -> S -> Either<&2, &1, List<&2, Char>, Sigma<&1, &1, B, _ => S>>) -> Either<&2, &1, List<&2, Char>, Sigma<&1, &1, B, _ => S>>:\n  (a, s) = p\n  f(a)(s)\n\ndef HsPt.state.map(-S: Data, -A: Type, -B: Data, f: A -> Either<&2, &2, List<&2, Char>, B>, p: Sigma<&1, &1, A, _ => S>) -> Either<&2, &1, List<&2, Char>, Sigma<&1, &1, B, _ => S>>:\n  (a, s) = p\n  HsPt.bindq(&2, &1, B, Sigma<&1, &1, B, _ => S>, f(a), b => Inr{(b, s)})\n\ndef HsPt.either.bind(-E: Data, -A: Data, -B: Data, m: Either<&2, &2, E, A>, f: A -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, B>>) -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, B>>:\n  match m:\n    case Inl{e}:\n      Inr{Inl{e}}\n    case Inr{a}:\n      f(a)\n\ndef HsPt.either.map(-E: Data, -A: Data, -B: Data, f: A -> Either<&2, &2, List<&2, Char>, B>, m: Either<&2, &2, E, A>) -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, B>>:\n  match m:\n    case Inl{e}:\n      Inr{Inl{e}}\n    case Inr{a}:\n      HsPt.bind(B, Either<&2, &2, E, B>, f(a), b => Inr{Inr{b}})\n\ndef HsPt.maybe.bind(-q: Quant, -A: Data, -B: Data, m: Maybe<&2, A>, f: A -> Either<&2, &2, List<&2, Char>, Maybe<&2, B>>) -> Either<&2, &2, List<&2, Char>, Maybe<&2, B>>:\n  match m:\n    case None{}:\n      Inr{None{}}\n    case Some{a}:\n      f(a)\n\ndef HsPt.maybe.map(-q: Quant, -A: Data, -B: Data, f: A -> Either<&2, &2, List<&2, Char>, B>, m: Maybe<&2, A>) -> Either<&2, &2, List<&2, Char>, Maybe<&2, B>>:\n  match m:\n    case None{}:\n      Inr{None{}}\n    case Some{a}:\n      HsPt.bind(B, Maybe<&2, B>, f(a), b => Inr{Some{b}})\n\ndef HsPt.cmaybe(-q: Quant, -A: Data, -R: Kind(q), d: Either<&2, q, List<&2, Char>, R>, f: A -> Either<&2, q, List<&2, Char>, R>, m: Maybe<&2, A>) -> Either<&2, q, List<&2, Char>, R>:\n  match m:\n    case None{}:\n      d\n    case Some{a}:\n      f(a)\n\ndef HsPt.ceither(-q: Quant, -A: Data, -B: Data, -R: Kind(q), f: A -> Either<&2, q, List<&2, Char>, R>, g: B -> Either<&2, q, List<&2, Char>, R>, m: Either<&2, &2, A, B>) -> Either<&2, q, List<&2, Char>, R>:\n  match m:\n    case Inl{a}:\n      f(a)\n    case Inr{b}:\n      g(b)\n\n# error and undefined at an answer that is no Data\ndef HsPt.errorq(-q: Quant, -A: Kind(q), msg: List<&2, Char>) -> Either<&2, q, List<&2, Char>, A>:\n  Inl{msg}\n\ndef HsPt.undefq(-q: Quant, -A: Kind(q)) -> Either<&2, q, List<&2, Char>, A>:\n"

def pre.HsPartial.p7() -> String:
  "  Inl{String.to_list(\"Prelude.undefined\")}\n\n# Data.Map's map, mapWithKey, filter and foldr given a partial function\n# (fd.pt.ho), in the keys' order (foldr's from the last)\ndef HsPt.mmap(~K: Data, ~V: Data, ~W: Data, ~f: V -> Either<&2, &2, List<&2, Char>, W>, m: HsMap<K, V>) -> Either<&2, &2, List<&2, Char>, HsMap<K, W>>:\n  match m:\n    case HsMap.Tip{}:\n      Inr{HsMap.Tip{}}\n    case HsMap.Bin{k, v, t}:\n      HsPt.bind(W, HsMap<K, W>, f(v), w => HsPt.bind(HsMap<K, W>, HsMap<K, W>, HsPt.mmap(~K, ~V, ~W, ~f, t), r => Inr{HsMap.Bin{k, w, r}}))\n\ndef HsPt.mmapk(~K: Data, ~V: Data, ~W: Data, ~f: K -> V -> Either<&2, &2, List<&2, Char>, W>, m: HsMap<K, V>) -> Either<&2, &2, List<&2, Char>, HsMap<K, W>>:\n  match m:\n    case HsMap.Tip{}:\n      Inr{HsMap.Tip{}}\n    case HsMap.Bin{+k, v, t}:\n      HsPt.bind(W, HsMap<K, W>, f(k)(v), w => HsPt.bind(HsMap<K, W>, HsMap<K, W>, HsPt.mmapk(~K, ~V, ~W, ~f, t), r => Inr{HsMap.Bin{k, w, r}}))\n\ndef HsPt.mkeep(-K: Data, -V: Data, k: K, v: V, b: Bool, r: HsMap<K, V>) -> HsMap<K, V>:\n  match b:\n    case True{}:\n      HsMap.Bin{k, v, r}\n    case False{}:\n      r\n\ndef HsPt.mfilter(~K: Data, ~V: Data, ~p: V -> Either<&2, &2, List<&2, Char>, Bool>, m: HsMap<K, V>) -> Either<&2, &2, List<&2, Char>, HsMap<K, V>>:\n  match m:\n    case HsMap.Tip{}:\n      Inr{HsMap.Tip{}}\n    case HsMap.Bin{k, +v, t}:\n      HsPt.bind(Bool, HsMap<K, V>, p(v), b => HsPt.bind(HsMap<K, V>, HsMap<K, V>, HsPt.mfilter(~K, ~V, ~p, t), r => Inr{HsPt.mkeep(K, V, k, v, b, r)}))\n\ndef HsPt.mfoldr(~K: Data, ~V: Data, ~B: Data, ~f: V -> B -> Either<&2, &2, List<&2, Char>, B>, z: B, m: HsMap<K, V>) -> Either<&2, &2, List<&2, Char>, B>:\n  match m:\n    case HsMap.Tip{}:\n      Inr{z}\n    case HsMap.Bin{k, v, t}:\n      HsPt.bind(B, B, HsPt.mfoldr(~K, ~V, ~B, ~f, z, t), r => f(v)(r))\n\n# uncurry given a partial function (fd.pt.unc)\ndef HsPt.uncurry(~q: Quant, ~A: Data, ~B: Data, ~C: Kind(q), f: A -> B -> Either<&2, q, List<&2, Char>, C>, p: Sigma<&2, &2, A, _ => B>) -> Either<&2, q, List<&2, Char>, C>:\n  (a, b) = p\n  f(a)(b)\n\n# Cata.Base's attempt given a partial call (fd.pt.ho.att)\ndef HsPt.attempt(-A: Data, m: Either<&2, &2, List<&2, Char>, A>) -> Maybe<&2, A>:\n  match m:\n    case Inl{e}:\n      None{}\n    case Inr{a}:\n      Some{a}\n\n# mapM and mapM_ in Either at a partial function: the first failure, GHC's or\n# the Either's, ends it\ndef HsPt.either.cons(-E: Data, -B: Data, b: B, r: Either<&2, &2, E, List<&2, B>>) -> Either<&2, &2, E, List<&2, B>>:\n  match r:\n    case Inl{e}:\n      Inl{e}\n    case Inr{bs}:\n      Inr{b <> bs}\n\n"

def pre.HsPartial.p8() -> String:
  "def HsPt.either.next(-E: Data, -B: Data, r: Either<&2, &2, E, B>, rest: Unit -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, List<&2, B>>>) -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, List<&2, B>>>:\n  match r:\n    case Inl{e}:\n      Inr{Inl{e}}\n    case Inr{b}:\n      HsPt.bind(Either<&2, &2, E, List<&2, B>>, Either<&2, &2, E, List<&2, B>>, rest(Unit{}), s => Inr{HsPt.either.cons(E, B, b, s)})\n\ndef HsPt.either.mapm(~E: Data, ~A: Data, ~B: Data, ~f: A -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, B>>, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, List<&2, B>>>:\n  match xs:\n    case Nil{}:\n      Inr{Inr{Nil{}}}\n    case h <> t:\n      HsPt.bind(Either<&2, &2, E, B>, Either<&2, &2, E, List<&2, B>>, f(h), r => HsPt.either.next(E, B, r, _ => HsPt.either.mapm(~E, ~A, ~B, ~f, t)))\n\ndef HsPt.either.unit(-E: Data, -B: Data, r: Either<&2, &2, E, List<&2, B>>) -> Either<&2, &2, E, Unit>:\n  match r:\n    case Inl{e}:\n      Inl{e}\n    case Inr{bs}:\n      Inr{Unit{}}\n\ndef HsPt.either.mapm_(~E: Data, ~A: Data, ~B: Data, ~f: A -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, B>>, xs: List<&2, A>) -> Either<&2, &2, List<&2, Char>, Either<&2, &2, E, Unit>>:\n  HsPt.bind(Either<&2, &2, E, List<&2, B>>, Either<&2, &2, E, Unit>, HsPt.either.mapm(~E, ~A, ~B, ~f, xs), r => Inr{HsPt.either.unit(E, B, r)})\n\n# Cata.Base's holdE given a partial call: what it answers, held\ndef HsPt.hold(-A: Data, m: Either<&2, &2, List<&2, Char>, A>) -> Either<&2, &2, List<&2, Char>, A>:\n  m\n"

def pre.HsPartial() -> String:
  pre.HsPartial.p0() ++ pre.HsPartial.p1() ++ pre.HsPartial.p2() ++ pre.HsPartial.p3() ++ pre.HsPartial.p4() ++ pre.HsPartial.p5() ++ pre.HsPartial.p6() ++ pre.HsPartial.p7() ++ pre.HsPartial.p8()
def pre.HsPc.p0() -> String:
  "\n# Text.Megaparsec's Parsec Void String (megaparsec 9.7.0, parser-combinators\n# 1.3.1): a parser is a function of the state to a reply, HsPcSt ->\n# HsPcRep<A>, the reply megaparsec's four continuations folded into one\n# value: whether input was consumed, and a result with the hints (what an\n# error at that offset would also have expected) or an error. Positions are\n# counted as megaparsec's reachOffset counts them (tab width 8; a wide\n# character is one column here, two there). A parser is a closure, called at\n# most once, so the combinators that run a parser again (many, sepBy,\n# manyTill, ...) take it as a template, given an environment E of the\n# caller's data it names (Unit when none).\n\ntype HsPcItem is Data:\n  HsPcItem.Tokens{ts: List<&2, Char>}\n  HsPcItem.Label{l: List<&2, Char>}\n  HsPcItem.Eoi{}\n\ntype HsPcFancy is Data:\n  HsPcFancy.Fail{msg: List<&2, Char>}\n  HsPcFancy.Indent{ord: Cmp, ref: Nat, act: Nat}\n\ntype HsPcError is Data:\n  HsPcError.Trivial{off: Nat, un: Maybe<&2, HsPcItem>, ex: List<&2, HsPcItem>}\n  HsPcError.Fancy{off: Nat, xs: List<&2, HsPcFancy>}\n\n# the input left, its offset, the line and column there, the source's name\ntype HsPcSt is Data:\n  HsPcSt{inp: List<&2, Char>, off: Nat, line: Nat, col: Nat, name: List<&2, Char>}\n\ntype HsPcRes<-A: Data> is Data:\n  HsPcRes.Ok{x: A, s: HsPcSt, hs: List<&2, HsPcItem>}\n  HsPcRes.Bad{e: HsPcError, s: HsPcSt}\n\ntype HsPcRep<-A: Data> is Data:\n  HsPcRep{c: Bool, r: HsPcRes<A>}\n\n# SourcePos: the name, the line and the column (each Pos a Nat from 1)\ntype HsPcPos is Data:\n  HsPcPos{name: List<&2, Char>, line: Nat, col: Nat}\n\n# ParseErrorBundle: the error and the input and name the run started with\ntype HsPcBundle is Data:\n  HsPcBundle{e: HsPcError, inp: List<&2, Char>, name: List<&2, Char>}\n\n# Sets as ascending lists: ErrorItem's derived Ord (Tokens < Label < end of\n# input), ErrorFancy's (ErrorFail < ErrorIndentation)\n\ndef HsPc.cmp.cmp(a: Cmp, b: Cmp) -> Cmp:\n  match a b:\n    case LT{} LT{}:\n      EQ{}\n    case LT{} _:\n      LT{}\n    case EQ{} LT{}:\n      GT{}\n    case EQ{} EQ{}:\n      EQ{}\n    case EQ{} GT{}:\n      LT{}\n    case GT{} GT{}:\n      EQ{}\n    case GT{} _:\n      GT{}\n\n# a lexicographic compare: the first's unless EQ\ndef HsPc.cmp.then(a: Cmp, b: Cmp) -> Cmp:\n  match a:\n    case EQ{}:\n      b\n    case o:\n      o\n\ndef HsPc.cmp.str(a: List<&2, Char>, b: List<&2, Char>) -> Cmp:\n  HsCmp.list(~Char, ~HsCmp.char, a, b)\n\n# == at strings\ndef HsPc.str.eq(xs: List<&2, Char>, ys: List<&2, Char>) -> Bool:\n  match xs ys:\n    case Nil{} Nil{}:\n      True{}\n    case x <> xt y <> yt:\n      Bool.and(Char.is_eq(x, y), HsPc.str.eq(xt, yt))\n    case _ _:\n      False{}\n\ndef HsPc.cmp.item(a: HsPcItem, b: HsPcItem) -> Cmp:\n"

def pre.HsPc.p1() -> String:
  "  match a b:\n    case HsPcItem.Tokens{x} HsPcItem.Tokens{y}:\n      HsPc.cmp.str(x, y)\n    case HsPcItem.Tokens{x} _:\n      LT{}\n    case HsPcItem.Label{x} HsPcItem.Tokens{y}:\n      GT{}\n    case HsPcItem.Label{x} HsPcItem.Label{y}:\n      HsPc.cmp.str(x, y)\n    case HsPcItem.Label{x} HsPcItem.Eoi{}:\n      LT{}\n    case HsPcItem.Eoi{} HsPcItem.Eoi{}:\n      EQ{}\n    case HsPcItem.Eoi{} _:\n      GT{}\n\ndef HsPc.cmp.fancy(a: HsPcFancy, b: HsPcFancy) -> Cmp:\n  match a b:\n    case HsPcFancy.Fail{x} HsPcFancy.Fail{y}:\n      HsPc.cmp.str(x, y)\n    case HsPcFancy.Fail{x} _:\n      LT{}\n    case HsPcFancy.Indent{o1, r1, a1} HsPcFancy.Fail{y}:\n      GT{}\n    case HsPcFancy.Indent{o1, r1, a1} HsPcFancy.Indent{o2, r2, a2}:\n      HsPc.cmp.then(HsPc.cmp.cmp(o1, o2), HsPc.cmp.then(Nat.cmp(r1, r2), Nat.cmp(a1, a2)))\n\ndef HsPc.iset.ins(+x: HsPcItem, xs: List<&2, HsPcItem>) -> List<&2, HsPcItem>:\n  match xs:\n    case Nil{}:\n      [x]\n    case +h <> +t:\n      HsCmp.on(List<&2, HsPcItem>, HsPc.cmp.item(x, h), _ => x <> h <> t, _ => h <> t, _ => h <> HsPc.iset.ins(x, t))\n\ndef HsPc.iset.union(xs: List<&2, HsPcItem>, ys: List<&2, HsPcItem>) -> List<&2, HsPcItem>:\n  match xs:\n    case Nil{}:\n      ys\n    case h <> t:\n      HsPc.iset.ins(h, HsPc.iset.union(t, ys))\n\ndef HsPc.fset.ins(+x: HsPcFancy, xs: List<&2, HsPcFancy>) -> List<&2, HsPcFancy>:\n  match xs:\n    case Nil{}:\n      [x]\n    case +h <> +t:\n      HsCmp.on(List<&2, HsPcFancy>, HsPc.cmp.fancy(x, h), _ => x <> h <> t, _ => h <> t, _ => h <> HsPc.fset.ins(x, t))\n\ndef HsPc.fset.union(xs: List<&2, HsPcFancy>, ys: List<&2, HsPcFancy>) -> List<&2, HsPcFancy>:\n  match xs:\n    case Nil{}:\n      ys\n    case h <> t:\n      HsPc.fset.ins(h, HsPc.fset.union(t, ys))\n\ndef HsPc.sset.ins(+x: List<&2, Char>, xs: List<&2, List<&2, Char>>) -> List<&2, List<&2, Char>>:\n  match xs:\n    case Nil{}:\n      [x]\n    case +h <> +t:\n      HsCmp.on(List<&2, List<&2, Char>>, HsPc.cmp.str(x, h), _ => x <> h <> t, _ => h <> t, _ => h <> HsPc.sset.ins(x, t))\n\n# the larger of two items (mergeError's max of the unexpected ones)\ndef HsPc.item.max(+a: HsPcItem, +b: HsPcItem) -> HsPcItem:\n  HsCmp.on(HsPcItem, HsPc.cmp.item(a, b), _ => b, _ => b, _ => a)\n\ndef HsPc.un.merge(a: Maybe<&2, HsPcItem>, b: Maybe<&2, HsPcItem>) -> Maybe<&2, HsPcItem>:\n  match a b:\n    case None{} y:\n      y\n    case Some{x} None{}:\n      Some{x}\n    case Some{x} Some{y}:\n      Some{HsPc.item.max(x, y)}\n\ndef HsPc.err.off(e: HsPcError) -> Nat:\n  match e:\n    case HsPcError.Trivial{o, u, p}:\n      o\n    case HsPcError.Fancy{o, xs}:\n      o\n\n# errors at one offset merge; else the later one stands (ParseError's <>)\ndef HsPc.err.same(e1: HsPcError, e2: HsPcError) -> HsPcError:\n  match e1 e2:\n"

def pre.HsPc.p2() -> String:
  "    case HsPcError.Trivial{s1, u1, p1} HsPcError.Trivial{s2, u2, p2}:\n      HsPcError.Trivial{s1, HsPc.un.merge(u1, u2), HsPc.iset.union(p1, p2)}\n    case HsPcError.Fancy{s1, x1} HsPcError.Trivial{s2, u2, p2}:\n      HsPcError.Fancy{s1, x1}\n    case HsPcError.Trivial{s1, u1, p1} HsPcError.Fancy{s2, x2}:\n      HsPcError.Fancy{s2, x2}\n    case HsPcError.Fancy{s1, x1} HsPcError.Fancy{s2, x2}:\n      HsPcError.Fancy{s1, HsPc.fset.union(x1, x2)}\n\ndef HsPc.err.merge(+e1: HsPcError, +e2: HsPcError) -> HsPcError:\n  HsCmp.on(HsPcError, Nat.cmp(HsPc.err.off(e1), HsPc.err.off(e2)), _ => e2, _ => HsPc.err.same(e1, e2), _ => e1)\n\n# the later of two states (longestMatch)\ndef HsPc.st.off(s: HsPcSt) -> Nat:\n  match s:\n    case HsPcSt{i, o, l, c, n}:\n      o\n\ndef HsPc.longest(+s1: HsPcSt, +s2: HsPcSt) -> HsPcSt:\n  Bool.pick(HsPcSt, Nat.is_gt(HsPc.st.off(s1), HsPc.st.off(s2)), s1, s2)\n\n# an error's expected items as hints, if it is at the offset (toHints)\ndef HsPc.hints(+o: Nat, e: HsPcError) -> List<&2, HsPcItem>:\n  match e:\n    case HsPcError.Trivial{+eo, u, ps}:\n      Bool.pick(List<&2, HsPcItem>, Nat.is_eq(o, eo), ps, Nil{})\n    case HsPcError.Fancy{eo, xs}:\n      Nil{}\n\n# hints added to an error's expected items (withHints)\ndef HsPc.err.hint(+hs: List<&2, HsPcItem>, e: HsPcError) -> HsPcError:\n  match e:\n    case HsPcError.Trivial{o, u, ps}:\n      HsPcError.Trivial{o, u, HsPc.iset.union(ps, hs)}\n    case f:\n      f\n\n# The core ------------------------------------------------------------------\n\ndef HsPc.pure(-A: Data, x: A) -> HsPcSt -> HsPcRep<A>:\n  s => HsPcRep{False{}, HsPcRes.Ok{x, s, Nil{}}}\n\n# hints hs of the first parser, before a second that did not consume\ndef HsPc.res.hint(-B: Data, +hs: List<&2, HsPcItem>, r: HsPcRes<B>) -> HsPcRes<B>:\n  match r:\n    case HsPcRes.Ok{x, s, h2}:\n      HsPcRes.Ok{x, s, HsPc.iset.union(hs, h2)}\n    case HsPcRes.Bad{e, s}:\n      HsPcRes.Bad{HsPc.err.hint(hs, e), s}\n\ndef HsPc.bind.k(-B: Data, c1: Bool, +hs: List<&2, HsPcItem>, r: HsPcRep<B>) -> HsPcRep<B>:\n  match r:\n    case HsPcRep{True{}, r2}:\n      HsPcRep{True{}, r2}\n    case HsPcRep{False{}, r2}:\n      HsPcRep{c1, HsPc.res.hint(B, hs, r2)}\n\ndef HsPc.bind.go(-A: Data, -B: Data, r: HsPcRep<A>, k: A -> HsPcSt -> HsPcRep<B>) -> HsPcRep<B>:\n  match r:\n    case HsPcRep{c, HsPcRes.Ok{x, s, hs}}:\n      HsPc.bind.k(B, c, hs, k(x)(s))\n    case HsPcRep{c, HsPcRes.Bad{e, s}}:\n      HsPcRep{c, HsPcRes.Bad{e, s}}\n\ndef HsPc.bind(-A: Data, -B: Data, m: HsPcSt -> HsPcRep<A>, k: A -> HsPcSt -> HsPcRep<B>) -> HsPcSt -> HsPcRep<B>:\n  s => HsPc.bind.go(A, B, m(s), k)\n\ndef HsPc.map.go(-A: Data, -B: Data, f: A -> B, r: HsPcRep<A>) -> HsPcRep<B>:\n  match r:\n    case HsPcRep{c, HsPcRes.Ok{x, s, hs}}:\n"

def pre.HsPc.p3() -> String:
  "      HsPcRep{c, HsPcRes.Ok{f(x), s, hs}}\n    case HsPcRep{c, HsPcRes.Bad{e, s}}:\n      HsPcRep{c, HsPcRes.Bad{e, s}}\n\ndef HsPc.map(-A: Data, -B: Data, f: A -> B, m: HsPcSt -> HsPcRep<A>) -> HsPcSt -> HsPcRep<B>:\n  s => HsPc.map.go(A, B, f, m(s))\n\n# m >> n, m <* n, m *> n, x <$ m\ndef HsPc.then(-A: Data, -B: Data, m: HsPcSt -> HsPcRep<A>, n: HsPcSt -> HsPcRep<B>) -> HsPcSt -> HsPcRep<B>:\n  HsPc.bind(A, B, m, _ => n)\n\ndef HsPc.left(-A: Data, -B: Data, m: HsPcSt -> HsPcRep<A>, n: HsPcSt -> HsPcRep<B>) -> HsPcSt -> HsPcRep<A>:\n  HsPc.bind(A, A, m, x => HsPc.map(B, A, _ => x, n))\n\ndef HsPc.const(-A: Data, -B: Data, x: A, m: HsPcSt -> HsPcRep<B>) -> HsPcSt -> HsPcRep<A>:\n  HsPc.map(B, A, _ => x, m)\n\ndef HsPc.void(-A: Data, m: HsPcSt -> HsPcRep<A>) -> HsPcSt -> HsPcRep<Unit>:\n  HsPc.map(A, Unit, _ => Unit{}, m)\n\n# m <|> n: n at the state m began at, if m failed without consuming\ndef HsPc.alt.n(-A: Data, +err: HsPcError, +ms: HsPcSt, r: HsPcRep<A>) -> HsPcRep<A>:\n  match r:\n    case HsPcRep{True{}, HsPcRes.Ok{x, s, hs}}:\n      HsPcRep{True{}, HsPcRes.Ok{x, s, hs}}\n    case HsPcRep{True{}, HsPcRes.Bad{e, s}}:\n      HsPcRep{True{}, HsPcRes.Bad{HsPc.err.merge(e, err), HsPc.longest(ms, s)}}\n    case HsPcRep{False{}, HsPcRes.Ok{x, +s, hs}}:\n      HsPcRep{False{}, HsPcRes.Ok{x, s, HsPc.iset.union(HsPc.hints(HsPc.st.off(s), err), hs)}}\n    case HsPcRep{False{}, HsPcRes.Bad{e, s}}:\n      HsPcRep{False{}, HsPcRes.Bad{HsPc.err.merge(e, err), HsPc.longest(ms, s)}}\n\ndef HsPc.alt.go(-A: Data, r: HsPcRep<A>, n: HsPcSt -> HsPcRep<A>, s: HsPcSt) -> HsPcRep<A>:\n  match r:\n    case HsPcRep{False{}, HsPcRes.Bad{e, ms}}:\n      HsPc.alt.n(A, e, ms, n(s))\n    case other:\n      other\n\ndef HsPc.alt(-A: Data, m: HsPcSt -> HsPcRep<A>, n: HsPcSt -> HsPcRep<A>) -> HsPcSt -> HsPcRep<A>:\n  +s => HsPc.alt.go(A, m(s), n, s)\n\ndef HsPc.st.err(+s: HsPcSt, e: HsPcError) -> HsPcRes<Unit>:\n  HsPcRes.Bad{e, s}\n\n# empty (mzero): fails where it is, expecting nothing\ndef HsPc.empty(-A: Data) -> HsPcSt -> HsPcRep<A>:\n  +s => HsPcRep{False{}, HsPcRes.Bad{HsPcError.Trivial{HsPc.st.off(s), None{}, Nil{}}, s}}\n\ndef HsPc.fail(-A: Data, msg: List<&2, Char>) -> HsPcSt -> HsPcRep<A>:\n  +s => HsPcRep{False{}, HsPcRes.Bad{HsPcError.Fancy{HsPc.st.off(s), [HsPcFancy.Fail{msg}]}, s}}\n\n# the parser no run reaches (where Haskell's loops forever)\ndef HsPc.bottom(-A: Data) -> HsPcSt -> HsPcRep<A>:\n  +s => HsPcRep{False{}, HsPcRes.Bad{HsPcError.Fancy{HsPc.st.off(s), Nil{}}, s}}\n\ndef HsPc.try.go(-A: Data, r: HsPcRep<A>, +s: HsPcSt) -> HsPcRep<A>:\n  match r:\n    case HsPcRep{c, HsPcRes.Bad{e, s1}}:\n      HsPcRep{False{}, HsPcRes.Bad{e, s}}\n    case other:\n      other\n\ndef HsPc.try(-A: Data, p: HsPcSt -> HsPcRep<A>) -> HsPcSt -> HsPcRep<A>:\n"

def pre.HsPc.p4() -> String:
  "  +s => HsPc.try.go(A, p(s), s)\n\n# label l p (p <?> l); hidden is label \"\"\ndef HsPc.label.refresh(+el: Maybe<&2, HsPcItem>, hs: List<&2, HsPcItem>) -> List<&2, HsPcItem>:\n  match el hs:\n    case None{} _:\n      Nil{}\n    case Some{m} Nil{}:\n      Nil{}\n    case Some{m} _:\n      [m]\n\ndef HsPc.label.ex(el: Maybe<&2, HsPcItem>) -> List<&2, HsPcItem>:\n  match el:\n    case None{}:\n      Nil{}\n    case Some{m}:\n      [m]\n\ndef HsPc.label.go(-A: Data, +el: Maybe<&2, HsPcItem>, r: HsPcRep<A>) -> HsPcRep<A>:\n  match r:\n    case HsPcRep{True{}, HsPcRes.Ok{x, s, hs}}:\n      HsPcRep{True{}, HsPcRes.Ok{x, s, Bool.pick(List<&2, HsPcItem>, Maybe.is_none(&2, HsPcItem, el), Nil{}, hs)}}\n    case HsPcRep{False{}, HsPcRes.Ok{x, s, hs}}:\n      HsPcRep{False{}, HsPcRes.Ok{x, s, HsPc.label.refresh(el, hs)}}\n    case HsPcRep{False{}, HsPcRes.Bad{HsPcError.Trivial{o, u, ps}, s}}:\n      HsPcRep{False{}, HsPcRes.Bad{HsPcError.Trivial{o, u, HsPc.label.ex(el)}, s}}\n    case other:\n      other\n\ndef HsPc.label.of(l: List<&2, Char>) -> Maybe<&2, HsPcItem>:\n  match l:\n    case Nil{}:\n      None{}\n    case h <> t:\n      Some{HsPcItem.Label{h <> t}}\n\ndef HsPc.label(-A: Data, l: List<&2, Char>, p: HsPcSt -> HsPcRep<A>) -> HsPcSt -> HsPcRep<A>:\n  s => HsPc.label.go(A, HsPc.label.of(l), p(s))\n\ndef HsPc.hidden(-A: Data, p: HsPcSt -> HsPcRep<A>) -> HsPcSt -> HsPcRep<A>:\n  HsPc.label(A, Nil{}, p)\n\n# p <?> l (Text.Megaparsec's): label l p\ndef HsPc.labelf(-A: Data, p: HsPcSt -> HsPcRep<A>, l: List<&2, Char>) -> HsPcSt -> HsPcRep<A>:\n  HsPc.label(A, l, p)\n\n# Tokens ----------------------------------------------------------------------\n\n# the state after one character: a newline starts a line, a tab goes to the\n# next multiple of 8 plus 1\ndef HsPc.col.tab(+c: Nat) -> Nat:\n  Nat.sub(Nat.add(c, 8n), Nat.mod(Nat.sub(c, 1n), 8n))\n\ndef HsPc.adv(+ch: Char, +rest: List<&2, Char>, +o: Nat, +l: Nat, +c: Nat, +n: List<&2, Char>) -> HsPcSt:\n  +k = Char.to_u32(ch)\n  Bool.pick(HsPcSt, U32.is_eq(k, 10), HsPcSt{rest, 1n+o, 1n+l, 1n, n}, HsPcSt{rest, 1n+o, l, Bool.pick(Nat, U32.is_eq(k, 9), HsPc.col.tab(c), 1n+c), n})\n\n# token test ps: one character test takes, else the error expecting ps\ndef HsPc.sat.in(f: Char -> Bool, +ps: List<&2, HsPcItem>, inp: List<&2, Char>, +o: Nat, +l: Nat, +c: Nat, +n: List<&2, Char>) -> HsPcRep<Char>:\n  match inp:\n    case Nil{}:\n      HsPcRep{False{}, HsPcRes.Bad{HsPcError.Trivial{o, Some{HsPcItem.Eoi{}}, ps}, HsPcSt{Nil{}, o, l, c, n}}}\n    case +h <> +t:\n      HsBool.if(HsPcRep<Char>, f(h), _ => HsPcRep{True{}, HsPcRes.Ok{h, HsPc.adv(h, t, o, l, c, n), Nil{}}}, _ => HsPcRep{False{}, HsPcRes.Bad{HsPcError.Trivial{o, Some{HsPcItem.Tokens{[h]}}, ps}, HsPcSt{h <> t, o, l, c, n}}})\n\n"

def pre.HsPc.p5() -> String:
  "def HsPc.sat.go(f: Char -> Bool, +ps: List<&2, HsPcItem>, s: HsPcSt) -> HsPcRep<Char>:\n  match s:\n    case HsPcSt{i, o, l, c, n}:\n      HsPc.sat.in(f, ps, i, o, l, c, n)\n\ndef HsPc.satisfy(f: Char -> Bool) -> HsPcSt -> HsPcRep<Char>:\n  s => HsPc.sat.go(f, Nil{}, s)\n\ndef HsPc.char(+ch: Char) -> HsPcSt -> HsPcRep<Char>:\n  s => HsPc.sat.go(x => Char.is_eq(x, ch), [HsPcItem.Tokens{[ch]}], s)\n\ndef HsPc.anySingle() -> HsPcSt -> HsPcRep<Char>:\n  HsPc.satisfy(_ => True{})\n\n# string (tokens (==)): all of it or nothing consumed\ndef HsPc.split.take(n: Nat, xs: List<&2, Char>) -> List<&2, Char>:\n  match n xs:\n    case 1n+k h <> t:\n      h <> HsPc.split.take(k, t)\n    case _ _:\n      Nil{}\n\ndef HsPc.split.drop(n: Nat, xs: List<&2, Char>) -> List<&2, Char>:\n  match n xs:\n    case 1n+k h <> t:\n      HsPc.split.drop(k, t)\n    case _ ys:\n      ys\n\ndef HsPc.split.cons(h: Char, a: List<&2, Char>, b: List<&2, Char>) -> Maybe<&2, Sigma<&2, &2, List<&2, Char>, _ => List<&2, Char>>>:\n  Some{(h <> a, b)}\n\ndef HsPc.split(n: Nat, xs: List<&2, Char>) -> Maybe<&2, Sigma<&2, &2, List<&2, Char>, _ => List<&2, Char>>>:\n  match n xs:\n    case 0n ys:\n      Some{(Nil{}, ys)}\n    case 1n+k Nil{}:\n      None{}\n    case 1n+(+k) h <> +t:\n      HsPc.split.cons(h, HsPc.split.take(k, t), HsPc.split.drop(k, t))\n\n# the state after the characters ts\ndef HsPc.advs(ts: List<&2, Char>, s: HsPcSt) -> HsPcSt:\n  match ts s:\n    case Nil{} s1:\n      s1\n    case +h <> t HsPcSt{i, +o, +l, +c, n}:\n      HsPc.advs(t, HsPc.adv(h, Nil{}, o, l, c, n))\n\ndef HsPc.st.input(s: HsPcSt, i: List<&2, Char>) -> HsPcSt:\n  match s:\n    case HsPcSt{i0, o, l, c, n}:\n      HsPcSt{i, o, l, c, n}\n\ndef HsPc.str.cmp(+tts: List<&2, Char>, m: Maybe<&2, Sigma<&2, &2, List<&2, Char>, _ => List<&2, Char>>>, +s: HsPcSt) -> HsPcRep<List<&2, Char>>:\n  match m:\n    case None{}:\n      HsPcRep{False{}, HsPcRes.Bad{HsPcError.Trivial{HsPc.st.off(s), Some{HsPcItem.Eoi{}}, [HsPcItem.Tokens{tts}]}, s}}\n    case Some{(+got, rest)}:\n      HsBool.if(HsPcRep<List<&2, Char>>, HsPc.str.eq(tts, got), _ => HsPcRep{Bool.not(List.is_empty(&2, Char, tts)), HsPcRes.Ok{got, HsPc.st.input(HsPc.advs(got, s), rest), Nil{}}}, _ => HsPcRep{False{}, HsPcRes.Bad{HsPcError.Trivial{HsPc.st.off(s), Some{HsPcItem.Tokens{got}}, [HsPcItem.Tokens{tts}]}, s}})\n\ndef HsPc.st.inp(s: HsPcSt) -> List<&2, Char>:\n  match s:\n    case HsPcSt{i, o, l, c, n}:\n      i\n\ndef HsPc.string(+tts: List<&2, Char>) -> HsPcSt -> HsPcRep<List<&2, Char>>:\n  +s => HsPc.str.cmp(tts, HsPc.split(List.length(&2, Char, tts), HsPc.st.inp(s)), s)\n\ndef HsPc.eof.in(i: List<&2, Char>, +s: HsPcSt) -> HsPcRep<Unit>:\n  match i:\n    case Nil{}:\n      HsPcRep{False{}, HsPcRes.Ok{Unit{}, s, Nil{}}}\n    case h <> t:\n"

def pre.HsPc.p6() -> String:
  "      HsPcRep{False{}, HsPcRes.Bad{HsPcError.Trivial{HsPc.st.off(s), Some{HsPcItem.Tokens{[h]}}, [HsPcItem.Eoi{}]}, s}}\n\ndef HsPc.eof() -> HsPcSt -> HsPcRep<Unit>:\n  +s => HsPc.eof.in(HsPc.st.inp(s), s)\n\n# what is next, as an error's unexpected item\ndef HsPc.next.item(i: List<&2, Char>) -> HsPcItem:\n  match i:\n    case Nil{}:\n      HsPcItem.Eoi{}\n    case h <> t:\n      HsPcItem.Tokens{[h]}\n\ndef HsPc.nfb.go(-A: Data, r: HsPcRep<A>, +s: HsPcSt) -> HsPcRep<Unit>:\n  match r:\n    case HsPcRep{c, HsPcRes.Ok{x, s1, hs}}:\n      HsPcRep{False{}, HsPcRes.Bad{HsPcError.Trivial{HsPc.st.off(s), Some{HsPc.next.item(HsPc.st.inp(s))}, Nil{}}, s}}\n    case HsPcRep{c, HsPcRes.Bad{e, s1}}:\n      HsPcRep{False{}, HsPcRes.Ok{Unit{}, s, Nil{}}}\n\ndef HsPc.notFollowedBy(-A: Data, p: HsPcSt -> HsPcRep<A>) -> HsPcSt -> HsPcRep<Unit>:\n  +s => HsPc.nfb.go(A, p(s), s)\n\ndef HsPc.look.go(-A: Data, r: HsPcRep<A>, +s: HsPcSt) -> HsPcRep<A>:\n  match r:\n    case HsPcRep{c, HsPcRes.Ok{x, s1, hs}}:\n      HsPcRep{False{}, HsPcRes.Ok{x, s, Nil{}}}\n    case other:\n      other\n\ndef HsPc.lookAhead(-A: Data, p: HsPcSt -> HsPcRep<A>) -> HsPcSt -> HsPcRep<A>:\n  +s => HsPc.look.go(A, p(s), s)\n\ndef HsPc.getOffset() -> HsPcSt -> HsPcRep<HsInt>:\n  +s => HsPcRep{False{}, HsPcRes.Ok{HsInt.Pos{HsPc.st.off(s)}, s, Nil{}}}\n\ndef HsPc.st.pos(s: HsPcSt) -> HsPcPos:\n  match s:\n    case HsPcSt{i, o, l, c, n}:\n      HsPcPos{n, l, c}\n\ndef HsPc.getSourcePos() -> HsPcSt -> HsPcRep<HsPcPos>:\n  +s => HsPcRep{False{}, HsPcRes.Ok{HsPc.st.pos(s), s, Nil{}}}\n\n# takeWhileP and takeWhile1P: the longest prefix f takes\ndef HsPc.tw.go(~f: Char -> Bool, i: List<&2, Char>, s: HsPcSt, +acc: List<&2, Char>) -> Sigma<&2, &2, List<&2, Char>, _ => HsPcSt>:\n  match i s:\n    case +h <> +t HsPcSt{i0, +o, +l, +c, +n}:\n      HsBool.if(Sigma<&2, &2, List<&2, Char>, _ => HsPcSt>, f(h), _ => HsPc.tw.go(~f, t, HsPc.adv(h, t, o, l, c, n), h <> acc), _ => (List.reverse(&2, Char, acc), HsPcSt{h <> t, o, l, c, n}))\n    case Nil{} s1:\n      (List.reverse(&2, Char, acc), s1)\n\ndef HsPc.tw.hs(ml: Maybe<&2, List<&2, Char>>) -> List<&2, HsPcItem>:\n  match ml:\n    case Some{h <> t}:\n      [HsPcItem.Label{h <> t}]\n    case _:\n      Nil{}\n\ndef HsPc.tw.rep(+hs: List<&2, HsPcItem>, p: Sigma<&2, &2, List<&2, Char>, _ => HsPcSt>) -> HsPcRep<List<&2, Char>>:\n  match p:\n    case (+ts, s1):\n      HsPcRep{Bool.not(List.is_empty(&2, Char, ts)), HsPcRes.Ok{ts, s1, hs}}\n\ndef HsPc.takeWhileP(~f: Char -> Bool, ml: Maybe<&2, List<&2, Char>>) -> HsPcSt -> HsPcRep<List<&2, Char>>:\n  +s => HsPc.tw.rep(HsPc.tw.hs(ml), HsPc.tw.go(~f, HsPc.st.inp(s), s, Nil{}))\n\ndef HsPc.tw1.rep(+hs: List<&2, HsPcItem>, p: Sigma<&2, &2, List<&2, Char>, _ => HsPcSt>, +s: HsPcSt) -> HsPcRep<List<&2, Char>>:\n  match p:\n"

def pre.HsPc.p7() -> String:
  "    case (Nil{}, s1):\n      HsPcRep{False{}, HsPcRes.Bad{HsPcError.Trivial{HsPc.st.off(s), Some{HsPc.next.item(HsPc.st.inp(s))}, hs}, s}}\n    case (ts, s1):\n      HsPcRep{True{}, HsPcRes.Ok{ts, s1, hs}}\n\ndef HsPc.takeWhile1P(~f: Char -> Bool, ml: Maybe<&2, List<&2, Char>>) -> HsPcSt -> HsPcRep<List<&2, Char>>:\n  +s => HsPc.tw1.rep(HsPc.tw.hs(ml), HsPc.tw.go(~f, HsPc.st.inp(s), s, Nil{}), s)\n\n# Running ------------------------------------------------------------------------\n\ndef HsPc.st0(name: List<&2, Char>, inp: List<&2, Char>) -> HsPcSt:\n  HsPcSt{inp, 0n, 1n, 1n, name}\n\ndef HsPc.run.go(-A: Data, r: HsPcRep<A>, +name: List<&2, Char>, +inp: List<&2, Char>) -> Either<&2, &2, HsPcBundle, A>:\n  match r:\n    case HsPcRep{c, HsPcRes.Ok{x, s, hs}}:\n      Inr{x}\n    case HsPcRep{c, HsPcRes.Bad{e, s}}:\n      Inl{HsPcBundle{e, inp, name}}\n\ndef HsPc.runParser(-A: Data, p: HsPcSt -> HsPcRep<A>, +name: List<&2, Char>, +inp: List<&2, Char>) -> Either<&2, &2, HsPcBundle, A>:\n  HsPc.run.go(A, p(HsPc.st0(name, inp)), name, inp)\n# a reply no run gives: fuel's default (rule 11), where Haskell's would not\n# stop\ndef HsPc.rep.default(-A: Data) -> HsPcRep<A>:\n  HsPcRep{False{}, HsPcRes.Bad{HsPcError.Fancy{0n, Nil{}}, HsPcSt{Nil{}, 0n, 1n, 1n, Nil{}}}}\n\n# optional p = (Just <$> p) <|> pure Nothing (Control.Applicative)\ndef HsPc.optional(-A: Data, p: HsPcSt -> HsPcRep<A>) -> HsPcSt -> HsPcRep<Maybe<&2, A>>:\n  HsPc.alt(Maybe<&2, A>, HsPc.map(A, Maybe<&2, A>, x => Some{x}, p), HsPc.pure(Maybe<&2, A>, None{}))\n\n# option x p = p <|> pure x\ndef HsPc.option(-A: Data, x: A, p: HsPcSt -> HsPcRep<A>) -> HsPcSt -> HsPcRep<A>:\n  HsPc.alt(A, p, HsPc.pure(A, x))\n\n# between open close p = open *> p <* close\ndef HsPc.between(-O: Data, -C: Data, -A: Data, o: HsPcSt -> HsPcRep<O>, c: HsPcSt -> HsPcRep<C>, p: HsPcSt -> HsPcRep<A>) -> HsPcSt -> HsPcRep<A>:\n  HsPc.left(A, C, HsPc.then(O, A, o, p), c)\n\n# Text.Megaparsec.Lexer's lexeme spc p = p <* spc and symbol spc = lexeme\n# spc . string\ndef HsPc.lexeme(-A: Data, spc: HsPcSt -> HsPcRep<Unit>, p: HsPcSt -> HsPcRep<A>) -> HsPcSt -> HsPcRep<A>:\n  HsPc.left(A, Unit, p, spc)\n\ndef HsPc.symbol(spc: HsPcSt -> HsPcRep<Unit>, +w: List<&2, Char>) -> HsPcSt -> HsPcRep<List<&2, Char>>:\n  HsPc.left(List<&2, Char>, Unit, HsPc.string(w), spc)\n\n# Char's space1 and space: takeWhile1P / takeWhileP (Just \"white space\")\n# isSpace (HsChar's, GHC's tables)\ndef HsPc.space1() -> HsPcSt -> HsPcRep<Unit>:\n  HsPc.void(List<&2, Char>, HsPc.takeWhile1P(~(c => HsChar.isSpace(c)), Some{String.to_list(\"white space\")}))\n\ndef HsPc.space() -> HsPcSt -> HsPcRep<Unit>:\n  HsPc.void(List<&2, Char>, HsPc.takeWhileP(~(c => HsChar.isSpace(c)), Some{String.to_list(\"white space\")}))\n\ndef HsPc.not.nl(+c: Char) -> Bool:\n"

def pre.HsPc.p8() -> String:
  "  Bool.not(U32.is_eq(Char.to_u32(c), 10))\n\n# skipLineComment prefix = string prefix *> void (takeWhileP (Just\n# \"character\") (/= '\\n'))\ndef HsPc.skipLineComment(+w: List<&2, Char>) -> HsPcSt -> HsPcRep<Unit>:\n  HsPc.then(List<&2, Char>, Unit, HsPc.string(w), HsPc.void(List<&2, Char>, HsPc.takeWhileP(~(c => HsPc.not.nl(c)), Some{String.to_list(\"character\")})))\n\n# SourcePos's fields, and indentLevel = sourceColumn <$> getSourcePos\ndef HsPc.pos.name(p: HsPcPos) -> List<&2, Char>:\n  match p:\n    case HsPcPos{n, l, c}:\n      n\n\ndef HsPc.pos.line(p: HsPcPos) -> Nat:\n  match p:\n    case HsPcPos{n, l, c}:\n      l\n\ndef HsPc.pos.col(p: HsPcPos) -> Nat:\n  match p:\n    case HsPcPos{n, l, c}:\n      c\n\ndef HsPc.indentLevel() -> HsPcSt -> HsPcRep<Nat>:\n  HsPc.map(HsPcPos, Nat, p => HsPc.pos.col(p), HsPc.getSourcePos())\n\n# incorrectIndent ord ref actual = fancyFailure {ErrorIndentation ord ref\n# actual}\ndef HsPc.incorrectIndent(-A: Data, o: Cmp, r: Nat, a: Nat) -> HsPcSt -> HsPcRep<A>:\n  +s => HsPcRep{False{}, HsPcRes.Bad{HsPcError.Fancy{HsPc.st.off(s), [HsPcFancy.Indent{o, r, a}]}, s}}\n\n# decimal = mkNum <$> takeWhile1P (Just \"digit\") isDigit <?> \"integer\"\ndef HsPc.digits(xs: List<&2, Char>, +acc: Nat) -> Nat:\n  match xs:\n    case Nil{}:\n      acc\n    case h <> t:\n      HsPc.digits(t, Nat.add(Nat.mul(acc, 10n), U32.to_nat(U32.sub(Char.to_u32(h), 48))))\n\ndef HsPc.decimal() -> HsPcSt -> HsPcRep<HsInt>:\n  HsPc.label(HsInt, String.to_list(\"integer\"), HsPc.map(List<&2, Char>, HsInt, ds => HsInt.Pos{HsPc.digits(ds, 0n)}, HsPc.takeWhile1P(~(c => HsChar.isDigit(c)), Some{String.to_list(\"digit\")})))\n\n# unexpected item: fails where it is, the item unexpected\ndef HsPc.unexpected(-A: Data, +i: HsPcItem) -> HsPcSt -> HsPcRep<A>:\n  +s => HsPcRep{False{}, HsPcRes.Bad{HsPcError.Trivial{HsPc.st.off(s), Some{i}, Nil{}}, s}}\n\n# Text.Megaparsec.Char.Lexer's charLiteral: label \"literal character\" of\n# GHC's readLitChar on the next at most 10 characters (lookAhead (count' 1\n# 10 anySingle)), then that many skipped: one character, or a backslash's\n# escape (\\a \\b \\f \\n \\r \\t \\v \\\\ \\\" \\', \\^X, \\NUL .. \\DEL and \\SP, a\n# decimal, \\o octal or \\x hexadecimal code below 0x110000)\ntype HsPcLit is Data:\n  HsPcLit{c: Char, n: Nat}\n\ndef HsPc.lit.one(+c: U32) -> Maybe<&2, HsPcLit>:\n  +k = Bool.pick(U32, U32.is_eq(c, 97), 7, Bool.pick(U32, U32.is_eq(c, 98), 8, Bool.pick(U32, U32.is_eq(c, 102), 12, Bool.pick(U32, U32.is_eq(c, 110), 10, Bool.pick(U32, U32.is_eq(c, 114), 13, Bool.pick(U32, U32.is_eq(c, 116), 9, Bool.pick(U32, U32.is_eq(c, 118), 11, Bool.pick(U32, Bool.or(Bool.or(U32.is_eq(c, 92), U32.is_eq(c, 34)), U32.is_eq(c, 39)), c, 1114112))))))))\n"

def pre.HsPc.p9() -> String:
  "  Bool.pick(Maybe<&2, HsPcLit>, U32.is_lt(k, 1114112), Some{HsPcLit{Char.from_u32(k), 2n}}, None{})\n\n# the value of a digit in base b, if it is one\ndef HsPc.lit.dig(+b: U32, +c: U32) -> U32:\n  +d = Bool.pick(U32, Bool.and(U32.is_ge(c, 48), U32.is_le(c, 57)), U32.sub(c, 48), Bool.pick(U32, Bool.and(U32.is_ge(c, 97), U32.is_le(c, 102)), U32.sub(c, 87), Bool.pick(U32, Bool.and(U32.is_ge(c, 65), U32.is_le(c, 70)), U32.sub(c, 55), 99)))\n  Bool.pick(U32, U32.is_lt(d, b), d, 99)\n\n# the digits at the front, their value capped above the largest code\ndef HsPc.lit.num(+b: U32, xs: List<&2, Char>, +v: U32, +n: Nat) -> HsPcLit:\n  match xs:\n    case Nil{}:\n      HsPcLit{Char.from_u32(v), n}\n    case +h <> t:\n      +d = HsPc.lit.dig(b, Char.to_u32(h))\n      HsBool.if(HsPcLit, U32.is_lt(d, 99), _ => HsPc.lit.num(b, t, U32.min(U32.add(U32.mul(v, b), d), 1114112), 1n+n), _ => HsPcLit{Char.from_u32(v), n})\n\ndef HsPc.lit.code(m: HsPcLit) -> Maybe<&2, HsPcLit>:\n  match m:\n    case HsPcLit{+c, +n}:\n      Bool.pick(Maybe<&2, HsPcLit>, Bool.and(U32.is_lt(Char.to_u32(c), 1114112), Nat.is_gt(n, 0n)), Some{HsPcLit{c, n}}, None{})\n\ndef HsPc.lit.at(m: HsPcLit, +k: Nat) -> HsPcLit:\n  match m:\n    case HsPcLit{c, n}:\n      HsPcLit{c, Nat.add(n, k)}\n\ndef HsPc.lit.base(+b: U32, xs: List<&2, Char>, +k: Nat) -> Maybe<&2, HsPcLit>:\n  Maybe.map(&2, HsPcLit, HsPcLit, m => HsPc.lit.at(m, k), HsPc.lit.code(HsPc.lit.num(b, xs, 0, 0n)))\n\n# \\^X: X from @ to _ is its code less 64\ndef HsPc.lit.ctl(xs: List<&2, Char>) -> Maybe<&2, HsPcLit>:\n  match xs:\n    case h <> t:\n      +k = Char.to_u32(h)\n      Bool.pick(Maybe<&2, HsPcLit>, Bool.and(U32.is_ge(k, 64), U32.is_le(k, 95)), Some{HsPcLit{Char.from_u32(U32.sub(k, 64)), 3n}}, None{})\n    case Nil{}:\n      None{}\n\n# the ASCII control names, SOH before SO (Text.Read.Lex tries it first)\ndef HsPc.lit.names() -> List<&2, HsPcLit>:\n"

def pre.HsPc.p10() -> String:
  "  [HsPcLit{Char.from_u32(0), 3n}, HsPcLit{Char.from_u32(1), 3n}, HsPcLit{Char.from_u32(2), 3n}, HsPcLit{Char.from_u32(3), 3n}, HsPcLit{Char.from_u32(4), 3n}, HsPcLit{Char.from_u32(5), 3n}, HsPcLit{Char.from_u32(6), 3n}, HsPcLit{Char.from_u32(7), 3n}, HsPcLit{Char.from_u32(8), 2n}, HsPcLit{Char.from_u32(9), 2n}, HsPcLit{Char.from_u32(10), 2n}, HsPcLit{Char.from_u32(11), 2n}, HsPcLit{Char.from_u32(12), 2n}, HsPcLit{Char.from_u32(13), 2n}, HsPcLit{Char.from_u32(14), 2n}, HsPcLit{Char.from_u32(15), 2n}, HsPcLit{Char.from_u32(16), 3n}, HsPcLit{Char.from_u32(17), 3n}, HsPcLit{Char.from_u32(18), 3n}, HsPcLit{Char.from_u32(19), 3n}, HsPcLit{Char.from_u32(20), 3n}, HsPcLit{Char.from_u32(21), 3n}, HsPcLit{Char.from_u32(22), 3n}, HsPcLit{Char.from_u32(23), 3n}, HsPcLit{Char.from_u32(24), 3n}, HsPcLit{Char.from_u32(25), 2n}, HsPcLit{Char.from_u32(26), 3n}, HsPcLit{Char.from_u32(27), 3n}, HsPcLit{Char.from_u32(28), 2n}, HsPcLit{Char.from_u32(29), 2n}, HsPcLit{Char.from_u32(30), 2n}, HsPcLit{Char.from_u32(31), 2n}, HsPcLit{Char.from_u32(32), 2n}, HsPcLit{Char.from_u32(127), 3n}]\n\ndef HsPc.lit.words() -> List<&2, List<&2, Char>>:\n  [String.to_list(\"NUL\"), String.to_list(\"SOH\"), String.to_list(\"STX\"), String.to_list(\"ETX\"), String.to_list(\"EOT\"), String.to_list(\"ENQ\"), String.to_list(\"ACK\"), String.to_list(\"BEL\"), String.to_list(\"BS\"), String.to_list(\"HT\"), String.to_list(\"LF\"), String.to_list(\"VT\"), String.to_list(\"FF\"), String.to_list(\"CR\"), String.to_list(\"SO\"), String.to_list(\"SI\"), String.to_list(\"DLE\"), String.to_list(\"DC1\"), String.to_list(\"DC2\"), String.to_list(\"DC3\"), String.to_list(\"DC4\"), String.to_list(\"NAK\"), String.to_list(\"SYN\"), String.to_list(\"ETB\"), String.to_list(\"CAN\"), String.to_list(\"EM\"), String.to_list(\"SUB\"), String.to_list(\"ESC\"), String.to_list(\"FS\"), String.to_list(\"GS\"), String.to_list(\"RS\"), String.to_list(\"US\"), String.to_list(\"SP\"), String.to_list(\"DEL\")]\n\ndef HsPc.lit.prefix(p: List<&2, Char>, xs: List<&2, Char>) -> Bool:\n  match p xs:\n    case Nil{} _:\n      True{}\n    case a <> pt b <> xt:\n      Bool.and(Char.is_eq(a, b), HsPc.lit.prefix(pt, xt))\n    case _ _:\n      False{}\n\ndef HsPc.lit.name(ws: List<&2, List<&2, Char>>, ls: List<&2, HsPcLit>, +xs: List<&2, Char>) -> Maybe<&2, HsPcLit>:\n  match ws ls:\n    case w <> wt HsPcLit{c, n} <> lt:\n      HsBool.if(Maybe<&2, HsPcLit>, HsPc.lit.prefix(w, xs), _ => Some{HsPcLit{c, 1n+n}}, _ => HsPc.lit.name(wt, lt, xs))\n    case _ _:\n      None{}\n\ndef HsPc.lit.esc(+h: Char, +t: List<&2, Char>) -> Maybe<&2, HsPcLit>:\n  +k = Char.to_u32(h)\n"

def pre.HsPc.p11() -> String:
  "  Bool.pick(Maybe<&2, HsPcLit>, Bool.and(U32.is_ge(k, 48), U32.is_le(k, 57)), HsPc.lit.base(10, h <> t, 1n), Bool.pick(Maybe<&2, HsPcLit>, U32.is_eq(k, 111), HsPc.lit.base(8, t, 2n), Bool.pick(Maybe<&2, HsPcLit>, U32.is_eq(k, 120), HsPc.lit.base(16, t, 2n), Bool.pick(Maybe<&2, HsPcLit>, U32.is_eq(k, 94), HsPc.lit.ctl(t), Maybe.or(&2, HsPcLit, HsPc.lit.one(k), HsPc.lit.name(HsPc.lit.words(), HsPc.lit.names(), h <> t))))))\n\ndef HsPc.lit.after(xs: List<&2, Char>) -> Maybe<&2, HsPcLit>:\n  match xs:\n    case +h <> +t:\n      HsPc.lit.esc(h, t)\n    case Nil{}:\n      None{}\n\ndef HsPc.lit.read(xs: List<&2, Char>) -> Maybe<&2, HsPcLit>:\n  match xs:\n    case +h <> t:\n      Bool.pick(Maybe<&2, HsPcLit>, U32.is_eq(Char.to_u32(h), 92), HsPc.lit.after(t), Some{HsPcLit{h, 1n}})\n    case Nil{}:\n      None{}\n\ndef HsPc.lit.got(m: Maybe<&2, HsPcLit>, +inp: List<&2, Char>, +s: HsPcSt) -> HsPcRep<Char>:\n  match m inp:\n    case Some{HsPcLit{c, +n}} _:\n      HsPcRep{True{}, HsPcRes.Ok{c, HsPc.st.input(HsPc.advs(HsPc.split.take(n, inp), s), HsPc.split.drop(n, inp)), Nil{}}}\n    case None{} h <> t:\n      HsPcRep{False{}, HsPcRes.Bad{HsPcError.Trivial{HsPc.st.off(s), Some{HsPcItem.Tokens{[h]}}, [HsPcItem.Label{String.to_list(\"literal character\")}]}, s}}\n    case None{} Nil{}:\n      HsPcRep{False{}, HsPcRes.Bad{HsPcError.Trivial{HsPc.st.off(s), Some{HsPcItem.Eoi{}}, [HsPcItem.Label{String.to_list(\"literal character\")}]}, s}}\n\ndef HsPc.charLiteral() -> HsPcSt -> HsPcRep<Char>:\n  +s => HsPc.lit.got(HsPc.lit.read(HsPc.split.take(10n, HsPc.st.inp(s))), HsPc.st.inp(s), s)\n\n# Pos and Int: unPos\ndef HsPc.unPos(n: Nat) -> HsInt:\n  HsInt.Pos{n}\n\n# errorBundlePretty ----------------------------------------------------------\n\n# where an offset is: its line and column, the line up to it, reversed,\n# and the input from it\ntype HsPcAt is Data:\n  HsPcAt{line: Nat, col: Nat, pre: List<&2, Char>, post: List<&2, Char>}\n\ndef HsPc.pp.walk(n: Nat, xs: List<&2, Char>, +l: Nat, +c: Nat, +acc: List<&2, Char>) -> HsPcAt:\n  match n xs:\n    case 1n+k +h <> t:\n      +u = Char.to_u32(h)\n      +nl = U32.is_eq(u, 10)\n      HsPc.pp.walk(k, t, Bool.pick(Nat, nl, 1n+l, l), Bool.pick(Nat, nl, 1n, Bool.pick(Nat, U32.is_eq(u, 9), HsPc.col.tab(c), 1n+c)), Bool.pick(List<&2, Char>, nl, Nil{}, h <> acc))\n    case _ ys:\n      HsPcAt{l, c, acc, ys}\n\ndef HsPc.pp.line(xs: List<&2, Char>) -> List<&2, Char>:\n  match xs:\n    case +h <> t:\n      HsBool.if(List<&2, Char>, U32.is_eq(Char.to_u32(h), 10), _ => Nil{}, _ => h <> HsPc.pp.line(t))\n    case Nil{}:\n      Nil{}\n\n# expandTab 8\ndef HsPc.pp.tabs(xs: List<&2, Char>, +i: Nat) -> List<&2, Char>:\n  match xs:\n    case +h <> t:\n      +k = Nat.sub(8n, Nat.mod(i, 8n))\n      +tab = U32.is_eq(Char.to_u32(h), 9)\n"

def pre.HsPc.p12() -> String:
  "      List.append(&2, Char, Bool.pick(List<&2, Char>, tab, List.replicate(Char, k, ' '), [h]), HsPc.pp.tabs(t, Bool.pick(Nat, tab, Nat.add(i, k), 1n+i)))\n    case Nil{}:\n      Nil{}\n\ndef HsPc.pp.nonempty(xs: List<&2, Char>) -> List<&2, Char>:\n  match xs:\n    case Nil{}:\n      String.to_list(\"<empty line>\")\n    case h <> t:\n      h <> t\n\ndef HsPc.pp.str(+s: String) -> List<&2, Char>:\n  String.to_list(s)\n\ndef HsPc.pp.nat(+n: Nat) -> List<&2, Char>:\n  String.to_list(Nat.show(n))\n\n# charPretty' (Text.Megaparsec.Stream)\ndef HsPc.pp.names() -> List<&2, String>:\n  [\"null\", \"start of heading\", \"start of text\", \"end of text\", \"end of transmission\", \"enquiry\", \"acknowledge\", \"bell\", \"backspace\", \"tab\", \"newline\", \"vertical tab\", \"form feed\", \"carriage return\", \"shift out\", \"shift in\", \"data link escape\", \"device control one\", \"device control two\", \"device control three\", \"device control four\", \"negative acknowledge\", \"synchronous idle\", \"end of transmission block\", \"cancel\", \"end of medium\", \"substitute\", \"escape\", \"file separator\", \"group separator\", \"record separator\", \"unit separator\"]\n\ndef HsPc.pp.nth(xs: List<&2, String>, n: Nat) -> List<&2, Char>:\n  match xs n:\n    case h <> t 0n:\n      String.to_list(h)\n    case h <> t 1n+k:\n      HsPc.pp.nth(t, k)\n    case Nil{} _:\n      Nil{}\n\ndef HsPc.pp.cname(+c: Char) -> Maybe<&2, List<&2, Char>>:\n  +k = Char.to_u32(c)\n  Bool.pick(Maybe<&2, List<&2, Char>>, U32.is_lt(k, 32), Some{HsPc.pp.nth(HsPc.pp.names(), U32.to_nat(k))}, Bool.pick(Maybe<&2, List<&2, Char>>, U32.is_eq(k, 127), Some{String.to_list(\"delete\")}, Bool.pick(Maybe<&2, List<&2, Char>>, U32.is_eq(k, 160), Some{String.to_list(\"non-breaking space\")}, None{})))\n\ndef HsPc.pp.char.at(m: Maybe<&2, List<&2, Char>>, +c: Char) -> List<&2, Char>:\n  match m:\n    case Some{n}:\n      n\n    case None{}:\n      ['\\'', c, '\\'']\n\ndef HsPc.pp.char(+c: Char) -> List<&2, Char>:\n  Bool.pick(List<&2, Char>, U32.is_eq(Char.to_u32(c), 32), String.to_list(\"space\"), HsPc.pp.char.at(HsPc.pp.cname(c), c))\n\ndef HsPc.pp.inner.at(m: Maybe<&2, List<&2, Char>>, +c: Char) -> List<&2, Char>:\n  match m:\n    case Some{n}:\n      List.append(&2, Char, '<' <> n, ['>'])\n    case None{}:\n      [c]\n\ndef HsPc.pp.inner(xs: List<&2, Char>) -> List<&2, Char>:\n  match xs:\n    case +h <> t:\n      List.append(&2, Char, HsPc.pp.inner.at(HsPc.pp.cname(h), h), HsPc.pp.inner(t))\n    case Nil{}:\n      Nil{}\n\ndef HsPc.pp.crlf(xs: List<&2, Char>) -> Bool:\n  match xs:\n    case a <> b <> Nil{}:\n      Bool.and(U32.is_eq(Char.to_u32(a), 13), U32.is_eq(Char.to_u32(b), 10))\n    case _:\n      False{}\n\n# stringPretty\ndef HsPc.pp.tokens(+xs: List<&2, Char>) -> List<&2, Char>:\n"

def pre.HsPc.p13() -> String:
  "  match xs:\n    case +h <> Nil{}:\n      HsPc.pp.char(h)\n    case ys:\n      Bool.pick(List<&2, Char>, HsPc.pp.crlf(ys), String.to_list(\"crlf newline\"), List.append(&2, Char, '\"' <> HsPc.pp.inner(ys), ['\"']))\n\ndef HsPc.pp.item(i: HsPcItem) -> List<&2, Char>:\n  match i:\n    case HsPcItem.Tokens{ts}:\n      HsPc.pp.tokens(ts)\n    case HsPcItem.Label{l}:\n      l\n    case HsPcItem.Eoi{}:\n      String.to_list(\"end of input\")\n\ndef HsPc.pp.items(xs: List<&2, HsPcItem>, acc: List<&2, List<&2, Char>>) -> List<&2, List<&2, Char>>:\n  match xs:\n    case Nil{}:\n      acc\n    case h <> t:\n      HsPc.pp.items(t, HsPc.sset.ins(HsPc.pp.item(h), acc))\n\ndef HsPc.pp.commas(xs: List<&2, List<&2, Char>>) -> List<&2, Char>:\n  match xs:\n    case x <> Nil{}:\n      List.append(&2, Char, String.to_list(\"or \"), x)\n    case x <> y <> t:\n      List.concat(&2, Char, [x, String.to_list(\", \"), HsPc.pp.commas(y <> t)])\n    case Nil{}:\n      Nil{}\n\n# orList\ndef HsPc.pp.or(xs: List<&2, List<&2, Char>>) -> List<&2, Char>:\n  match xs:\n    case x <> Nil{}:\n      x\n    case x <> y <> Nil{}:\n      List.concat(&2, Char, [x, String.to_list(\" or \"), y])\n    case x <> y <> z <> t:\n      List.concat(&2, Char, [x, String.to_list(\", \"), HsPc.pp.commas(y <> z <> t)])\n    case Nil{}:\n      Nil{}\n\ndef HsPc.pp.msg(+pre: String, xs: List<&2, List<&2, Char>>) -> List<&2, Char>:\n  match xs:\n    case Nil{}:\n      Nil{}\n    case h <> t:\n      List.concat(&2, Char, [String.to_list(pre), HsPc.pp.or(h <> t), ['\\n']])\n\ndef HsPc.pp.un(u: Maybe<&2, HsPcItem>) -> List<&2, HsPcItem>:\n  match u:\n    case None{}:\n      Nil{}\n    case Some{i}:\n      [i]\n\ndef HsPc.pp.cmpword(o: Cmp) -> List<&2, Char>:\n  match o:\n    case LT{}:\n      String.to_list(\"less than \")\n    case EQ{}:\n      String.to_list(\"equal to \")\n    case GT{}:\n      String.to_list(\"greater than \")\n\ndef HsPc.pp.fancy(f: HsPcFancy) -> List<&2, Char>:\n  match f:\n    case HsPcFancy.Fail{m}:\n      m\n    case HsPcFancy.Indent{o, r, a}:\n      List.concat(&2, Char, [String.to_list(\"incorrect indentation (got \"), HsPc.pp.nat(a), String.to_list(\", should be \"), HsPc.pp.cmpword(o), HsPc.pp.nat(r), [')']])\n\ndef HsPc.pp.unlines(xs: List<&2, HsPcFancy>) -> List<&2, Char>:\n  match xs:\n    case Nil{}:\n      Nil{}\n    case h <> t:\n      List.concat(&2, Char, [HsPc.pp.fancy(h), ['\\n'], HsPc.pp.unlines(t)])\n\ndef HsPc.pp.trivial(u: Maybe<&2, HsPcItem>, ps: List<&2, HsPcItem>) -> List<&2, Char>:\n  match u ps:\n    case None{} Nil{}:\n      String.to_list(\"unknown parse error\\n\")\n    case un es:\n      List.append(&2, Char, HsPc.pp.msg(\"unexpected \", HsPc.pp.items(HsPc.pp.un(un), Nil{})), HsPc.pp.msg(\"expecting \", HsPc.pp.items(es, Nil{})))\n\n# parseErrorTextPretty\n"

def pre.HsPc.p14() -> String:
  "def HsPc.pp.text(e: HsPcError) -> List<&2, Char>:\n  match e:\n    case HsPcError.Trivial{o, u, ps}:\n      HsPc.pp.trivial(u, ps)\n    case HsPcError.Fancy{o, Nil{}}:\n      String.to_list(\"unknown fancy parse error\\n\")\n    case HsPcError.Fancy{o, xs}:\n      HsPc.pp.unlines(xs)\n\n# the pointer's length: the unexpected item's (tokens: their number), else 1\ndef HsPc.pp.elen(e: HsPcError) -> Nat:\n  match e:\n    case HsPcError.Trivial{o, Some{HsPcItem.Tokens{ts}}, ps}:\n      List.length(&2, Char, ts)\n    case _:\n      1n\n\ndef HsPc.pp.where(+name: List<&2, Char>, +l: Nat, +c: Nat) -> List<&2, Char>:\n  +lc = List.concat(&2, Char, [HsPc.pp.nat(l), [':'], HsPc.pp.nat(c)])\n  Bool.pick(List<&2, Char>, List.is_empty(&2, Char, name), lc, List.concat(&2, Char, [name, [':'], lc]))\n\ndef HsPc.pp.at(+name: List<&2, Char>, a: HsPcAt, +e: HsPcError) -> List<&2, Char>:\n  match a:\n    case HsPcAt{+l, +c, pre, post}:\n      +sline = HsPc.pp.nonempty(HsPc.pp.tabs(List.append(&2, Char, List.reverse(&2, Char, pre), HsPc.pp.line(post)), 0n))\n      +rpshift = Nat.sub(c, 1n)\n      +slen = List.length(&2, Char, sline)\n      +elen = HsPc.pp.elen(e)\n      +plen = Bool.pick(Nat, Nat.is_gt(Nat.add(rpshift, elen), slen), Nat.sub(1n+slen, rpshift), elen)\n      +lnum = HsPc.pp.nat(l)\n      +pad = List.replicate(Char, 1n+List.length(&2, Char, lnum), ' ')\n      +rpad = Bool.pick(List<&2, Char>, Nat.is_gt(plen, 0n), List.replicate(Char, rpshift, ' '), Nil{})\n      List.concat(&2, Char, [HsPc.pp.where(name, l, c), String.to_list(\":\\n\"), pad, String.to_list(\"|\\n\"), lnum, String.to_list(\" | \"), sline, ['\\n'], pad, String.to_list(\"| \"), rpad, List.replicate(Char, plen, '^'), ['\\n'], HsPc.pp.text(e)])\n\n# errorBundlePretty, for a bundle of one error (runParser's)\ndef HsPc.errorBundlePretty(b: HsPcBundle) -> List<&2, Char>:\n  match b:\n    case HsPcBundle{+e, inp, +name}:\n      HsPc.pp.at(name, HsPc.pp.walk(HsPc.err.off(e), inp, 1n, 1n, Nil{}), e)\n\n\n# a parser's reply as the laws state it: the error's text\n# (errorBundlePretty), or the answer and the offset after it (inp: the input\n# it ran on, from st0)\ndef HsPc.answer(-A: Data, r: HsPcRep<A>, +inp: List<&2, Char>) -> Either<&2, &2, List<&2, Char>, Sigma<&2, &2, A, _ => HsInt>>:\n  match r:\n    case HsPcRep{c, HsPcRes.Ok{x, s, hs}}:\n      Inr{Tuple{x, HsInt.Pos{HsPc.st.off(s)}}}\n    case HsPcRep{c, HsPcRes.Bad{e, s}}:\n      Inl{HsPc.errorBundlePretty(HsPcBundle{e, inp, Nil{}})}\n"

def pre.HsPc() -> String:
  pre.HsPc.p0() ++ pre.HsPc.p1() ++ pre.HsPc.p2() ++ pre.HsPc.p3() ++ pre.HsPc.p4() ++ pre.HsPc.p5() ++ pre.HsPc.p6() ++ pre.HsPc.p7() ++ pre.HsPc.p8() ++ pre.HsPc.p9() ++ pre.HsPc.p10() ++ pre.HsPc.p11() ++ pre.HsPc.p12() ++ pre.HsPc.p13() ++ pre.HsPc.p14()
def pre.HsRange.p0() -> String:
  "# GHC.Enum's [a .. b] at Nat (Int, Integer and Natural in a module alone) and\n# at Char, and [a, b .. c] at Nat and at HsInt, a and b different (Fold.bend's\n# fd.range and fd.range3: the fold writes it at two different literals, so it\n# ends)\ndef HsList.range.go(n: Nat, +a: Nat) -> List<&2, Nat>:\n  match n:\n    case 0n:\n      Nil{}\n    case 1n+p:\n      a <> HsList.range.go(p, 1n+a)\n\ndef HsList.range(+a: Nat, b: Nat) -> List<&2, Nat>:\n  HsList.range.go(Nat.sub(1n+b, a), a)\n\ndef HsList.rangeChar.go(n: Nat, +a: U32) -> List<&2, Char>:\n  match n:\n    case 0n:\n      Nil{}\n    case 1n+p:\n      Char.from_u32(a) <> HsList.rangeChar.go(p, U32.add(a, 1))\n\ndef HsList.rangeChar.at(+a: U32, +b: U32) -> List<&2, Char>:\n  HsList.rangeChar.go(Bool.pick(Nat, U32.is_le(a, b), U32.to_nat(U32.add(U32.sub(b, a), 1)), 0n), a)\n\ndef HsList.rangeChar(a: Char, b: Char) -> List<&2, Char>:\n  HsList.rangeChar.at(Char.to_u32(a), Char.to_u32(b))\n\ndef HsList.rangeUp(n: Nat, +a: Nat, +d: Nat) -> List<&2, Nat>:\n  match n:\n    case 0n:\n      Nil{}\n    case 1n+p:\n      a <> HsList.rangeUp(p, Nat.add(a, d), d)\n\ndef HsList.rangeDown(n: Nat, +a: Nat, +d: Nat) -> List<&2, Nat>:\n  match n:\n    case 0n:\n      Nil{}\n    case 1n+p:\n      a <> HsList.rangeDown(p, Nat.sub(a, d), d)\n\n# how many steps of d there are in n, and the first (0 when none: n < m)\ndef HsList.rangeBy.n(+m: Nat, +n: Nat, d: Nat) -> Nat:\n  Bool.pick(Nat, Nat.is_le(m, n), 1n+Nat.div(Nat.sub(n, m), d), 0n)\n\ndef HsList.rangeBy(+a: Nat, +b: Nat, +c: Nat) -> List<&2, Nat>:\n  +up = Nat.sub(b, a)\n  +dn = Nat.sub(a, b)\n  HsBool.if(List<&2, Nat>, Nat.is_lt(a, b), _ => HsList.rangeUp(HsList.rangeBy.n(a, c, up), a, up), _ => HsList.rangeDown(HsList.rangeBy.n(c, a, dn), a, dn))\n\ndef HsInt.rangeBy.go(n: Nat, +a: HsInt, +d: HsInt) -> List<&2, HsInt>:\n  match n:\n    case 0n:\n      Nil{}\n    case 1n+p:\n      a <> HsInt.rangeBy.go(p, HsInt.add(a, d), d)\n\n# the steps of d (its size) in the count of c - a toward it\ndef HsInt.rangeBy.n(+m: HsInt, d: Nat) -> Nat:\n  Bool.pick(Nat, HsInt.isneg(m), 0n, 1n+Nat.div(HsInt.mag(m), d))\n\ndef HsInt.rangeBy(+a: HsInt, +b: HsInt, +c: HsInt) -> List<&2, HsInt>:\n  +d = HsInt.sub(b, a)\n  +m = Bool.pick(HsInt, HsInt.isneg(d), HsInt.sub(a, c), HsInt.sub(c, a))\n  HsInt.rangeBy.go(HsInt.rangeBy.n(m, HsInt.mag(d)), a, d)\n\n# even and odd at Nat\ndef HsNum.even(n: Nat) -> Bool:\n  match n:\n    case 0n:\n      True{}\n    case 1n+p:\n      Bool.not(HsNum.even(p))\n\ndef HsNum.odd(n: Nat) -> Bool:\n  Bool.not(HsNum.even(n))\n"

def pre.HsRange() -> String:
  pre.HsRange.p0()
def pre.HsRational.p0() -> String:
  "# Haskell's Rational (Data.Ratio's Ratio Integer) as GHC keeps it: a\n# fraction num / den in lowest terms with den at least 1, so each rational\n# is one term and two are equal when their fields are. A zero denominator\n# (x / 0, n % 0) is GHC's error \"Ratio has zero denominator\"; here it\n# answers 0, the type's default, as a fuelled def does at the end of its\n# fuel (an error is out of this translation's reach).\ntype HsRational is Data:\n  HsRational{num: HsInt, den: Nat}\n\n# Euclid's gcd, fuelled by b + 1: each step's b is smaller than the last\ndef HsRational.gcd.go(fuel: Nat, a: Nat, b: Nat) -> Nat:\n  match fuel b:\n    case 0n _:\n      a\n    case _ 0n:\n      a\n    case 1n+p 1n+(+q):\n      HsRational.gcd.go(p, 1n+q, Nat.mod(a, 1n+q))\n\ndef HsRational.gcd(+a: Nat, +b: Nat) -> Nat:\n  HsRational.gcd.go(1n+b, a, b)\n\ndef HsRational.zero() -> HsRational:\n  HsRational{HsInt.Pos{0n}, 1n}\n\ndef HsRational.mk.at(+g: Nat, +n: HsInt, +d: Nat) -> HsRational:\n  match g:\n    case 0n:\n      HsRational.zero()\n    case 1n+k:\n      HsRational{HsInt.mul.sign(HsInt.isneg(n), Nat.div(HsInt.mag(n), g)), Nat.div(d, g)}\n\n# n / d in lowest terms (GHC's reduce)\ndef HsRational.mk(+n: HsInt, +d: Nat) -> HsRational:\n  match d:\n    case 0n:\n      HsRational.zero()\n    case 1n+k:\n      HsRational.mk.at(HsRational.gcd(HsInt.mag(n), d), n, d)\n\ndef HsRational.of(n: HsInt) -> HsRational:\n  HsRational{n, 1n}\n\ndef HsRational.numerator(r: HsRational) -> HsInt:\n  match r:\n    case HsRational{p, q}:\n      p\n\ndef HsRational.denominator(r: HsRational) -> HsInt:\n  match r:\n    case HsRational{p, q}:\n      HsInt.Pos{q}\n\ndef HsRational.add(a: HsRational, b: HsRational) -> HsRational:\n  match a b:\n    case HsRational{p, +q} HsRational{r, +s}:\n      HsRational.mk(HsInt.add(HsInt.mul(p, HsInt.Pos{s}), HsInt.mul(r, HsInt.Pos{q})), Nat.mul(q, s))\n\ndef HsRational.negate(a: HsRational) -> HsRational:\n  match a:\n    case HsRational{p, q}:\n      HsRational{HsInt.negate(p), q}\n\ndef HsRational.sub(a: HsRational, b: HsRational) -> HsRational:\n  HsRational.add(a, HsRational.negate(b))\n\ndef HsRational.mul(a: HsRational, b: HsRational) -> HsRational:\n  match a b:\n    case HsRational{p, q} HsRational{r, s}:\n      HsRational.mk(HsInt.mul(p, r), Nat.mul(q, s))\n\n# (p / q) / (r / s) = p s / q r, the sign r's\ndef HsRational.div(a: HsRational, b: HsRational) -> HsRational:\n  match a b:\n    case HsRational{p, q} HsRational{+r, s}:\n      HsRational.mk(HsInt.mul(HsInt.mul(p, HsInt.Pos{s}), HsInt.signum(r)), Nat.mul(q, HsInt.mag(r)))\n\ndef HsRational.abs(a: HsRational) -> HsRational:\n  match a:\n    case HsRational{p, q}:\n      HsRational{HsInt.abs(p), q}\n\ndef HsRational.signum(a: HsRational) -> HsRational:\n  match a:\n"

def pre.HsRational.p1() -> String:
  "    case HsRational{p, q}:\n      HsRational{HsInt.signum(p), 1n}\n\n# p / q against r / s: p s against r q (q, s at least 1)\ndef HsRational.cmp(a: HsRational, b: HsRational) -> Cmp:\n  match a b:\n    case HsRational{p, q} HsRational{r, s}:\n      HsInt.cmp(HsInt.mul(p, HsInt.Pos{s}), HsInt.mul(r, HsInt.Pos{q}))\n\ndef HsRational.is_eq(a: HsRational, b: HsRational) -> Bool:\n  Cmp.is_eq(HsRational.cmp(a, b))\n\ndef HsRational.is_ne(a: HsRational, b: HsRational) -> Bool:\n  Bool.not(Cmp.is_eq(HsRational.cmp(a, b)))\n\ndef HsRational.is_lt(a: HsRational, b: HsRational) -> Bool:\n  Cmp.is_lt(HsRational.cmp(a, b))\n\ndef HsRational.is_le(a: HsRational, b: HsRational) -> Bool:\n  Cmp.is_le(HsRational.cmp(a, b))\n\ndef HsRational.is_gt(a: HsRational, b: HsRational) -> Bool:\n  Cmp.is_gt(HsRational.cmp(a, b))\n\ndef HsRational.is_ge(a: HsRational, b: HsRational) -> Bool:\n  Cmp.is_ge(HsRational.cmp(a, b))\n\ndef HsRational.max(+a: HsRational, +b: HsRational) -> HsRational:\n  Bool.pick(HsRational, Cmp.is_ge(HsRational.cmp(a, b)), a, b)\n\ndef HsRational.min(+a: HsRational, +b: HsRational) -> HsRational:\n  Bool.pick(HsRational, Cmp.is_le(HsRational.cmp(a, b)), a, b)\n\n# GHC.Real's showsPrec: showParen (d > 7) (showsPrec 8 p . (\" % \" ++) .\n# showsPrec 8 q)\ndef HsRational.shows(+d: HsInt, x: HsRational, r: List<&2, Char>) -> List<&2, Char>:\n  match x:\n    case HsRational{p, q}:\n      HsShow.paren(HsInt.is_gt(d, HsInt.Pos{7n}), s => HsShow.int(HsInt.Pos{8n}, p, List.append(&2, Char, String.to_list(\" % \"), HsShow.int(HsInt.Pos{8n}, HsInt.Pos{q}, s))), r)\n\ndef HsRational.show(x: HsRational) -> List<&2, Char>:\n  HsRational.shows(HsInt.Pos{0n}, x, Nil{})\n\n# Data.Ratio's n % d, the sign on the numerator\ndef HsInt.ratio(+a: HsInt, +b: HsInt) -> HsRational:\n  HsRational.mk(HsInt.mul.sign(Bool.xor(HsInt.isneg(a), HsInt.isneg(b)), HsInt.mag(a)), HsInt.mag(b))\n\ndef HsInt.gcd(+a: HsInt, +b: HsInt) -> HsInt:\n  HsInt.Pos{HsRational.gcd(HsInt.mag(a), HsInt.mag(b))}\n\ndef HsInt.lcm.at(+g: Nat, +a: Nat, +b: Nat) -> HsInt:\n  match g:\n    case 0n:\n      HsInt.Pos{0n}\n    case 1n+k:\n      HsInt.Pos{Nat.mul(Nat.div(a, g), b)}\n\ndef HsInt.lcm(+a: HsInt, +b: HsInt) -> HsInt:\n  HsInt.lcm.at(HsRational.gcd(HsInt.mag(a), HsInt.mag(b)), HsInt.mag(a), HsInt.mag(b))\n"

def pre.HsRational() -> String:
  pre.HsRational.p0() ++ pre.HsRational.p1()
def pre.HsShowMore.p0() -> String:
  "# Show at pairs, at Data.Map's maps and at Data.Set's sets (Fold.bend's\n# fd.sp), each given showsPrec at its parts, as HsShow.maybe is. GHC.Show's\n# pair: showsPrec d (a, b) r = '(' : shows a (',' : shows b (')' : r)),\n# each part at precedence 0 and d unused. containers' map and set:\n# showsPrec d m = showParen (d > 10) (showString \"fromList \" . shows\n# (toList m)), the list in key order, a map's entries as pairs.\ndef HsShow.pair(~A: Data, ~B: Data, ~sa: HsInt -> A -> List<&2, Char> -> List<&2, Char>, ~sb: HsInt -> B -> List<&2, Char> -> List<&2, Char>, p: Sigma<&2, &2, A, _ => B>, r: List<&2, Char>) -> List<&2, Char>:\n  match p:\n    case Tuple{a, b}:\n      '(' <> sa(HsInt.Pos{0n})(a)(',' <> sb(HsInt.Pos{0n})(b)(')' <> r))\n\ndef HsShow.map(~K: Data, ~V: Data, ~sk: HsInt -> K -> List<&2, Char> -> List<&2, Char>, ~sv: HsInt -> V -> List<&2, Char> -> List<&2, Char>, d: HsInt, m: HsMap<K, V>, r: List<&2, Char>) -> List<&2, Char>:\n  HsShow.paren(HsInt.is_ge(d, HsInt.Pos{11n}), s => List.append(&2, Char, String.to_list(\"fromList \"), HsShow.list(~Sigma<&2, &2, K, _ => V>, ~(y => t => HsShow.pair(~K, ~V, ~sk, ~sv, y, t)), HsMap.toList(~K, ~V, m), s)), r)\n\ndef HsShow.set(~K: Data, ~sk: HsInt -> K -> List<&2, Char> -> List<&2, Char>, d: HsInt, m: HsSet<K>, r: List<&2, Char>) -> List<&2, Char>:\n  HsShow.paren(HsInt.is_ge(d, HsInt.Pos{11n}), s => List.append(&2, Char, String.to_list(\"fromList \"), HsShow.list(~K, ~(y => t => sk(HsInt.Pos{0n})(y)(t)), HsSet.toList(~K, m), s)), r)\n\n# showsPrec at a list and at a pair, its precedence unused (Spec's sp.shw:\n# at a type that holds one of the package's, spList and spPair)\ndef HsShow.listP(~A: Data, ~sp: HsInt -> A -> List<&2, Char> -> List<&2, Char>, d: HsInt, xs: List<&2, A>, r: List<&2, Char>) -> List<&2, Char>:\n  HsShow.list(~A, ~(y => t => sp(HsInt.Pos{0n})(y)(t)), xs, r)\n\ndef HsShow.pairP(~A: Data, ~B: Data, ~sa: HsInt -> A -> List<&2, Char> -> List<&2, Char>, ~sb: HsInt -> B -> List<&2, Char> -> List<&2, Char>, d: HsInt, p: Sigma<&2, &2, A, _ => B>, r: List<&2, Char>) -> List<&2, Char>:\n  HsShow.pair(~A, ~B, ~sa, ~sb, p, r)\n"

def pre.HsShowMore() -> String:
  pre.HsShowMore.p0()
