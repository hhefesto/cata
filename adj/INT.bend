# generated by adj/IntGhc.hs (adj/int.zsh) from GHC's Int and Int8; do not edit
# Each ghc def: the model's Int primitive (Core.bend's z.prim) at every
# pair of the grid -4..4 squared is GHC's Int's answer there; each ghc8
# def: the model's Int of range 127 (z.primw at RgInt{127n}) at every
# pair of Int8's edges is GHC's Int8's answer (None: divide by zero, or
# overflow, minBound `div` (-1)).

import Base
import ./Core.bend as C

def tbl(+p: C.Prim, g: List<&2, C.ZV>) -> List<&2, Maybe<&2, C.ZV>>:
  match g:
    case Nil{}:
      Nil{}
    case v <> rest:
      C.z.prim(p, v) <> tbl(p, rest)

def tbl8(+p: C.Prim, g: List<&2, C.ZV>) -> List<&2, Maybe<&2, C.ZV>>:
  match g:
    case Nil{}:
      Nil{}
    case v <> rest:
      C.z.primw(p, v, C.RgInt{C.int8.max()}) <> tbl8(p, rest)

